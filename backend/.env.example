DATABASE_URL="postgresql://postgres:postgres@localhost:5432/assetflow?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/assetflow?schema=public"
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="7d"
PORT=4000
CLIENT_ORIGIN="http://localhost:5173"
NODE_ENV="development"
ENCRYPTION_KEY="replace-with-a-generated-64-char-hex-key"

# Frontend base URL used for links inside emails (password reset, security
# alerts). Falls back to the first CLIENT_ORIGIN when unset.
APP_URL="http://localhost:5173"

# Public base URL of this API, used to build the Company Calendar feed link
# that Google Calendar / Outlook subscribe to (e.g. https://api.example.com/api).
# Falls back to the request's own host. Must be reachable from the internet
# for Google/Outlook to fetch it - a localhost URL will not sync.
API_PUBLIC_URL=""

# Outgoing email (project deadline reminders, failed-login security alerts,
# "forgot password" reset links). Without these, alerts are in-app only and
# reset links are printed to the backend console in development.
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-smtp-user"
SMTP_PASS="your-smtp-password"
SMTP_FROM="AssetFlow <no-reply@example.com>"
PROJECT_DEADLINE_REMINDER_DAYS="3"

# Billing: emails allowed to create/edit/delete plans and sales (comma-separated).
# Unset = the CEOs of the first company ever created.
BILLING_PLAN_ADMIN_EMAILS=
# Where "Contact Our Team" inquiries are emailed (they're always saved in the DB too).
SALES_EMAIL=

# ManagementDock Control Center: there is no setting for it. The platform account
# is a separate PLATFORM_ADMIN user created with scripts/create-platform-admin.js.
