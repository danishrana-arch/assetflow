DATABASE_URL="postgresql://postgres:postgres@localhost:5432/assetflow?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/assetflow?schema=public"
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="7d"
PORT=4000
CLIENT_ORIGIN="http://localhost:5173"
NODE_ENV="development"
ENCRYPTION_KEY="replace-with-a-generated-64-char-hex-key"

# Frontend base URL used for links inside emails (password reset, security
# alerts). Falls back to the first CLIENT_ORIGIN when unset.
APP_URL="http://localhost:5173"

# Outgoing email (project deadline reminders, failed-login security alerts,
# "forgot password" reset links). Without these, alerts are in-app only and
# reset links are printed to the backend console in development.
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-smtp-user"
SMTP_PASS="your-smtp-password"
SMTP_FROM="AssetFlow <no-reply@example.com>"
PROJECT_DEADLINE_REMINDER_DAYS="3"
