DATABASE_URL="postgresql://postgres:postgres@localhost:5432/assetflow?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/assetflow?schema=public"
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="7d"
PORT=4000
CLIENT_ORIGIN="http://localhost:5173"
NODE_ENV="development"
# 64-char hex string (32 bytes) used to encrypt CNIC at rest. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="replace-with-a-generated-64-char-hex-key"
