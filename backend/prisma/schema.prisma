generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Organization {
  id                        String                    @id @default(cuid())
  name                      String
  slug                      String                    @unique
  logoUrl                   String?
  primaryColor              String                    @default("#3E63DD")
  accentColor               String                    @default("#16A34A")
  theme                     String                    @default("light")
  planTier                  PlanTier                  @default(FREE)
  createdAt                 DateTime                  @default(now())
  updatedAt                 DateTime                  @updatedAt
  casualLeaveAllowance      Int                       @default(6)
  sickLeaveAllowance        Int                       @default(8)
  lateDeductionAmount       Decimal                   @default(500) @db.Decimal(10, 2)
  payrollAccountNumber      String?
  payrollBankName           String?
  workingHoursPerDay        Decimal                   @default(8) @db.Decimal(4, 2)
  workingDaysPerWeek        Int                       @default(5)
  companyId                 String?
  parentOrganizationId      String?
  geofenceEnabled           Boolean                   @default(false)
  officeLatitude            Decimal?                  @db.Decimal(10, 7)
  officeLongitude           Decimal?                  @db.Decimal(10, 7)
  geofenceRadiusMeters      Int                       @default(200)
  archivedAt                DateTime?
  shiftStartDefault         String?
  shiftEndDefault           String?
  lateThresholdMinutes      Int                       @default(15)
  breakEnd                  String?
  breakStart                String?
  timezone                  String                    @default("Asia/Karachi")
  remoteOfflineGraceMinutes Int                       @default(30)
  announcements             Announcement[]
  assets                    Asset[]
  AttendanceAnomaly         AttendanceAnomaly[]
  AttendanceCorrection      AttendanceCorrection[]
  AttendancePresenceEvent   AttendancePresenceEvent[]
  AttendanceSite            AttendanceSite[]
  AttendanceSyncEvent       AttendanceSyncEvent[]
  auditLogs                 AuditLog[]
  biometricDevices          BiometricDevice[]
  biometricPunches          BiometricPunch[]
  companyEvents             CompanyEvent[]
  departments               Department[]
  employeeForms             EmployeeForm[]
  EmployeeFormInvitation    EmployeeFormInvitation[]
  formSubmissions           EmployeeFormSubmission[]
  holidays                  Holiday[]
  notifications             Notification[]
  company                   Organization?             @relation("CompanyOrganizations", fields: [companyId], references: [id])
  organizations             Organization[]            @relation("CompanyOrganizations")
  parentOrganization        Organization?             @relation("OrganizationHierarchy", fields: [parentOrganizationId], references: [id])
  childOrganizations        Organization[]            @relation("OrganizationHierarchy")
  performanceReviews        PerformanceReview[]
  projects                  Project[]
  tasks                     Task[]
  tickets                   Ticket[]
  TimeEntry                 TimeEntry[]
  users                     User[]
  workCategories            WorkCategory[]

  @@index([companyId])
  @@index([parentOrganizationId])
  @@index([archivedAt])
}

model Announcement {
  id             String       @id @default(cuid())
  organizationId String
  createdById    String
  title          String
  body           String
  audienceType   String       @default("ALL")
  audienceId     String?
  publishedAt    DateTime     @default(now())
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  createdBy      User         @relation("AnnouncementCreator", fields: [createdById], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, publishedAt])
  @@index([audienceType, audienceId])
}

model CompanyEvent {
  id             String       @id @default(cuid())
  organizationId String
  createdById    String?
  title          String
  date           DateTime     @db.Date
  description    String?
  type           String       @default("ANNUAL_EVENT")
  isAnnual       Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  createdBy      User?        @relation("CompanyEventCreator", fields: [createdById], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, date])
  @@index([organizationId, type])
}

model Holiday {
  id             String       @id @default(cuid())
  organizationId String
  date           DateTime     @db.Date
  name           String
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, date])
  @@index([organizationId])
}

model AuditLog {
  id             String       @id @default(cuid())
  organizationId String
  actorId        String?
  action         String
  targetType     String?
  targetId       String?
  note           String?
  createdAt      DateTime     @default(now())
  actor          User?        @relation(fields: [actorId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, createdAt])
}

model User {
  id                                                           String                    @id @default(cuid())
  organizationId                                               String
  name                                                         String
  email                                                        String                    @unique
  password                                                     String
  phone                                                        String?
  photoUrl                                                     String?
  role                                                         UserRole                  @default(EMPLOYEE)
  status                                                       EmployeeStatus            @default(ACTIVE)
  departmentId                                                 String?
  managerId                                                    String?
  cnic                                                         String?
  dob                                                          DateTime?
  address                                                      String?
  skill                                                        String?
  seniorityLevel                                               SeniorityLevel?
  canManageAttendance                                          Boolean                   @default(false)
  createdAt                                                    DateTime                  @default(now())
  updatedAt                                                    DateTime                  @updatedAt
  baseSalary                                                   Decimal?                  @db.Decimal(12, 2)
  bankAccountNumber                                            String?
  bankName                                                     String?
  designation                                                  String?
  joiningDate                                                  DateTime?
  workLocationType                                             WorkLocationType          @default(OFFICE)
  personalEmail                                                String?
  fatherName                                                   String?
  education                                                    String?
  currentUniversity                                            String?
  linkedinUrl                                                  String?
  shiftStart                                                   String?
  shiftEnd                                                     String?
  announcementsCreated                                         Announcement[]            @relation("AnnouncementCreator")
  assignedAssets                                               Asset[]                   @relation("AssignedAssets")
  assetRequests                                                AssetRequest[]            @relation("AssetRequestedBy")
  assetRequestsReviewed                                        AssetRequest[]            @relation("AssetRequestReviewer")
  AttendanceAnomaly_AttendanceAnomaly_employeeIdToUser         AttendanceAnomaly[]       @relation("AttendanceAnomaly_employeeIdToUser")
  AttendanceAnomaly_AttendanceAnomaly_resolvedByIdToUser       AttendanceAnomaly[]       @relation("AttendanceAnomaly_resolvedByIdToUser")
  AttendanceCorrection_AttendanceCorrection_employeeIdToUser   AttendanceCorrection[]    @relation("AttendanceCorrection_employeeIdToUser")
  AttendanceCorrection_AttendanceCorrection_reviewedByIdToUser AttendanceCorrection[]    @relation("AttendanceCorrection_reviewedByIdToUser")
  AttendancePresenceEvent                                      AttendancePresenceEvent[]
  attendanceRecords                                            AttendanceRecord[]        @relation("AttendanceOf")
  attendanceMarkedBy                                           AttendanceRecord[]        @relation("AttendanceMarkedBy")
  AttendanceSite                                               AttendanceSite[]
  AttendanceSiteEmployee                                       AttendanceSiteEmployee[]
  AttendanceSyncEvent                                          AttendanceSyncEvent[]
  auditLogs                                                    AuditLog[]
  biometricMappings                                            BiometricDeviceEmployee[]
  biometricPunches                                             BiometricPunch[]
  certifications                                               Certification[]
  companyEvents                                                CompanyEvent[]            @relation("CompanyEventCreator")
  managedDepartments                                           Department[]              @relation("DepartmentManager")
  employeeFormsCreated                                         EmployeeForm[]            @relation("EmployeeFormCreator")
  EmployeeFormInvitation                                       EmployeeFormInvitation[]
  formSubmissionsConverted                                     EmployeeFormSubmission[]  @relation("FormSubmissionEmployee")
  leaveApplications                                            LeaveApplication[]        @relation("LeaveApplicant")
  leaveApplicationsReviewed                                    LeaveApplication[]        @relation("LeaveReviewer")
  lifecycleEvents                                              LifecycleEvent[]          @relation("EventActor")
  notificationsCreated                                         Notification[]            @relation("NotificationCreator")
  notifications                                                Notification[]            @relation("NotificationRecipient")
  payrollApprovedBy                                            PayrollRecord[]           @relation("PayrollApprovedBy")
  payrollRecords                                               PayrollRecord[]           @relation("PayrollOf")
  payrollGeneratedBy                                           PayrollRecord[]           @relation("PayrollGeneratedBy")
  performanceReviews                                           PerformanceReview[]       @relation("PerformanceEmployee")
  performanceGiven                                             PerformanceReview[]       @relation("PerformanceReviewer")
  managedProjects                                              Project[]                 @relation("ProjectManager")
  projectMemberships                                           ProjectMember[]
  assignedTasks                                                Task[]                    @relation("TaskAssignee")
  createdTasks                                                 Task[]                    @relation("TaskCreator")
  tickets                                                      Ticket[]                  @relation("TicketRaisedBy")
  TimeEntry                                                    TimeEntry[]
  department                                                   Department?               @relation(fields: [departmentId], references: [id])
  manager                                                      User?                     @relation("ManagerReports", fields: [managerId], references: [id])
  reports                                                      User[]                    @relation("ManagerReports")
  organization                                                 Organization              @relation(fields: [organizationId], references: [id])
}

model Notification {
  id             String       @id @default(cuid())
  organizationId String
  recipientId    String
  createdById    String?
  type           String       @default("INFO")
  title          String
  message        String?
  link           String?
  createdAt      DateTime     @default(now())
  readAt         DateTime?
  createdBy      User?        @relation("NotificationCreator", fields: [createdById], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  recipient      User         @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId, readAt, createdAt])
  @@index([organizationId, createdAt])
}

model Certification {
  id            String    @id @default(cuid())
  employeeId    String
  name          String
  institute     String
  credentialId  String?
  credentialUrl String?
  issuedDate    DateTime?
  expiryDate    DateTime?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  employee      User      @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
}

model EmployeeForm {
  id             String                   @id @default(cuid())
  organizationId String
  createdById    String?
  title          String
  tokenHash      String                   @unique
  tokenEncrypted String?
  active         Boolean                  @default(true)
  expiresAt      DateTime?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  createdBy      User?                    @relation("EmployeeFormCreator", fields: [createdById], references: [id])
  organization   Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  submissions    EmployeeFormSubmission[]

  @@index([organizationId, active])
}

model EmployeeFormSubmission {
  id                     String                       @id @default(cuid())
  invitationId           String                       @unique
  organizationId         String
  data                   Json
  submittedAt            DateTime                     @default(now())
  createdAt              DateTime                     @default(now())
  updatedAt              DateTime
  formId                 String?
  name                   String?
  fatherName             String?
  personalEmail          String?
  phone                  String?
  address                String?
  cnic                   String?
  dob                    DateTime?
  education              String?
  currentUniversity      String?
  seniorityLevel         SeniorityLevel?
  companyEmail           String?
  linkedinUrl            String?
  notes                  String?
  status                 EmployeeFormSubmissionStatus @default(SUBMITTED)
  convertedEmployeeId    String?
  convertedEmployee      User?                        @relation("FormSubmissionEmployee", fields: [convertedEmployeeId], references: [id])
  form                   EmployeeForm?                @relation(fields: [formId], references: [id], onDelete: Cascade)
  EmployeeFormInvitation EmployeeFormInvitation       @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  organization           Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([formId, submittedAt])
  @@index([organizationId, status])
  @@index([organizationId, submittedAt])
}

model LeaveApplication {
  id             String      @id @default(cuid())
  organizationId String
  employeeId     String
  startDate      DateTime    @db.Date
  endDate        DateTime    @db.Date
  reason         String
  type           LeaveType   @default(CASUAL)
  isHalfDay      Boolean     @default(false)
  status         LeaveStatus @default(PENDING)
  reviewedById   String?
  reviewedAt     DateTime?
  reviewNote     String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  employee       User        @relation("LeaveApplicant", fields: [employeeId], references: [id], onDelete: Cascade)
  reviewedBy     User?       @relation("LeaveReviewer", fields: [reviewedById], references: [id])

  @@index([organizationId, status])
  @@index([employeeId])
}

model AssetRequest {
  id               String             @id @default(cuid())
  organizationId   String
  employeeId       String
  category         String
  reason           String
  status           AssetRequestStatus @default(PENDING)
  reviewedById     String?
  reviewedAt       DateTime?
  reviewNote       String?
  fulfilledAssetId String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  employee         User               @relation("AssetRequestedBy", fields: [employeeId], references: [id], onDelete: Cascade)
  fulfilledAsset   Asset?             @relation(fields: [fulfilledAssetId], references: [id])
  reviewedBy       User?              @relation("AssetRequestReviewer", fields: [reviewedById], references: [id])

  @@index([organizationId, status])
  @@index([employeeId])
}

model Department {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  createdAt      DateTime     @default(now())
  managerId      String?
  assets         Asset[]
  manager        User?        @relation("DepartmentManager", fields: [managerId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id])
  employees      User[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([managerId])
}

model Asset {
  id                String           @id @default(cuid())
  organizationId    String
  name              String
  category          String?
  serialNumber      String           @unique
  cpu               String?
  ram               String?
  storage           String?
  purchaseDate      DateTime?
  warrantyEnd       DateTime?
  status            AssetStatus      @default(AVAILABLE)
  departmentId      String?
  assignedToId      String?
  photos            String[]         @default([])
  documents         String[]         @default([])
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  assignedTo        User?            @relation("AssignedAssets", fields: [assignedToId], references: [id])
  department        Department?      @relation(fields: [departmentId], references: [id])
  organization      Organization     @relation(fields: [organizationId], references: [id])
  fulfilledRequests AssetRequest[]
  lifecycleEvents   LifecycleEvent[]
  tickets           Ticket[]
}

model LifecycleEvent {
  id         String             @id @default(cuid())
  assetId    String
  type       LifecycleEventType
  note       String?
  actorId    String?
  occurredAt DateTime           @default(now())
  cost       Decimal?           @db.Decimal(10, 2)
  actor      User?              @relation("EventActor", fields: [actorId], references: [id])
  asset      Asset              @relation(fields: [assetId], references: [id])
}

model Project {
  id                        String           @id @default(cuid())
  organizationId            String
  name                      String
  description               String?
  clientName                String?
  projectUrl                String?
  status                    ProjectStatus    @default(NOT_STARTED)
  startDate                 DateTime?        @db.Date
  deadline                  DateTime?        @db.Date
  completedAt               DateTime?
  totalHours                Decimal          @default(0) @db.Decimal(10, 2)
  managerId                 String?
  createdAt                 DateTime         @default(now())
  updatedAt                 DateTime         @updatedAt
  technologies              String[]         @default([])
  deadlineReminderSentAt    DateTime?
  deadlineOverdueNotifiedAt DateTime?
  workCategoryId            String?
  AttendanceSite            AttendanceSite[]
  manager                   User?            @relation("ProjectManager", fields: [managerId], references: [id])
  organization              Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workCategory              WorkCategory?    @relation(fields: [workCategoryId], references: [id])
  members                   ProjectMember[]
  tasks                     Task[]
  TimeEntry                 TimeEntry[]

  @@index([organizationId, status])
  @@index([organizationId, deadline])
}

model ProjectMember {
  id         String   @id @default(cuid())
  projectId  String
  employeeId String
  hoursSpent Decimal  @default(0) @db.Decimal(10, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  employee   User     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, employeeId])
  @@index([employeeId])
}

model Task {
  id             String       @id @default(cuid())
  organizationId String
  projectId      String
  title          String
  description    String?
  status         String       @default("TODO")
  priority       String       @default("MEDIUM")
  assignedToId   String?
  createdById    String?
  dueDate        DateTime?    @db.Date
  estimatedHours Decimal      @default(0) @db.Decimal(10, 2)
  actualHours    Decimal      @default(0) @db.Decimal(10, 2)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  assignedTo     User?        @relation("TaskAssignee", fields: [assignedToId], references: [id])
  createdBy      User?        @relation("TaskCreator", fields: [createdById], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  TimeEntry      TimeEntry[]

  @@index([organizationId, status])
  @@index([organizationId, projectId])
  @@index([assignedToId, status])
  @@index([dueDate])
}

model PerformanceReview {
  id             String       @id @default(cuid())
  organizationId String
  employeeId     String
  reviewerId     String?
  periodStart    DateTime     @db.Date
  periodEnd      DateTime     @db.Date
  rating         Int
  goals          String?
  achievements   String?
  feedback       String?
  status         String       @default("DRAFT")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  employee       User         @relation("PerformanceEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reviewer       User?        @relation("PerformanceReviewer", fields: [reviewerId], references: [id])

  @@index([organizationId, employeeId, periodEnd])
  @@index([reviewerId, createdAt])
}

model WorkCategory {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  technologies   String[]     @default([])
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  projects       Project[]
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, name])
  @@index([organizationId, isActive])
}

model Ticket {
  id             String         @id @default(cuid())
  organizationId String
  subject        String
  description    String
  priority       TicketPriority @default(MEDIUM)
  status         TicketStatus   @default(OPEN)
  imageUrl       String?
  raisedById     String?
  assetId        String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  category       String?
  asset          Asset?         @relation(fields: [assetId], references: [id])
  organization   Organization   @relation(fields: [organizationId], references: [id])
  raisedBy       User?          @relation("TicketRaisedBy", fields: [raisedById], references: [id])
}

model BiometricDevice {
  id                      String                    @id @default(cuid())
  organizationId          String
  name                    String
  vendor                  BiometricVendor
  model                   String?
  serialNumber            String?
  ipAddress               String?
  port                    Int?
  connectionMode          BiometricConnectionMode   @default(PULL)
  enabled                 Boolean                   @default(true)
  doorEnabled             Boolean                   @default(false)
  unlockSeconds           Int                       @default(5)
  relayUrl                String?
  relaySecret             String?
  communicationKey        String?
  connectorTokenHash      String?
  connectorTokenCreatedAt DateTime?
  lastSeenAt              DateTime?
  lastSyncAt              DateTime?
  lastError               String?
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  organization            Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  mappings                BiometricDeviceEmployee[]
  punches                 BiometricPunch[]

  @@unique([organizationId, serialNumber])
  @@index([organizationId])
}

model BiometricDeviceEmployee {
  id             String          @id @default(cuid())
  deviceId       String
  employeeId     String
  externalUserId String
  createdAt      DateTime        @default(now())
  device         BiometricDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  employee       User            @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([deviceId, externalUserId])
  @@unique([deviceId, employeeId])
  @@index([employeeId])
}

model BiometricPunch {
  id             String          @id @default(cuid())
  organizationId String
  deviceId       String
  employeeId     String?
  externalUserId String
  occurredAt     DateTime
  verification   String?
  externalId     String?
  rawPayload     Json?
  createdAt      DateTime        @default(now())
  fingerprint    String?         @unique
  device         BiometricDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  employee       User?           @relation(fields: [employeeId], references: [id])
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([deviceId, externalId])
  @@index([organizationId, occurredAt])
  @@index([deviceId, occurredAt])
}

model AttendanceRecord {
  id                      String                    @id @default(cuid())
  organizationId          String
  employeeId              String
  date                    DateTime                  @db.Date
  status                  AttendanceStatus          @default(PRESENT)
  markedById              String?
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  source                  AttendanceSource          @default(MANUAL)
  biometricDeviceId       String?
  checkInAt               DateTime?
  checkOutAt              DateTime?
  workingMinutes          Int?
  latitude                Decimal?                  @db.Decimal(10, 7)
  longitude               Decimal?                  @db.Decimal(10, 7)
  distanceMeters          Int?
  autoFlagged             Boolean                   @default(false)
  siteId                  String?
  offlineRecorded         Boolean                   @default(false)
  localRecordedAt         DateTime?
  syncedAt                DateTime?
  clientEventId           String?
  gpsAccuracy             Float?
  networkType             String?
  attendanceDeviceId      String?
  verificationHash        String?
  AttendanceAnomaly       AttendanceAnomaly[]
  AttendanceCorrection    AttendanceCorrection[]
  AttendancePresenceEvent AttendancePresenceEvent[]
  employee                User                      @relation("AttendanceOf", fields: [employeeId], references: [id], onDelete: Cascade)
  markedBy                User?                     @relation("AttendanceMarkedBy", fields: [markedById], references: [id])

  @@unique([employeeId, date])
  @@index([organizationId, date])
  @@index([biometricDeviceId])
  @@index([offlineRecorded])
  @@index([siteId, date])
}

model PayrollRecord {
  id                String        @id @default(cuid())
  organizationId    String
  employeeId        String
  month             Int
  year              Int
  baseSalary        Decimal       @db.Decimal(12, 2)
  bonus             Decimal       @default(0) @db.Decimal(12, 2)
  deductions        Decimal       @default(0) @db.Decimal(12, 2)
  unpaidLeaveDays   Int           @default(0)
  netPay            Decimal       @db.Decimal(12, 2)
  status            PayrollStatus @default(DRAFT)
  note              String?
  generatedById     String?
  paidAt            DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  approvedAt        DateTime?
  approvedById      String?
  bankAccountNumber String?
  bankName          String?
  halfDayLeaveDays  Int           @default(0)
  lateDays          Int           @default(0)
  approvedBy        User?         @relation("PayrollApprovedBy", fields: [approvedById], references: [id])
  employee          User          @relation("PayrollOf", fields: [employeeId], references: [id], onDelete: Cascade)
  generatedBy       User?         @relation("PayrollGeneratedBy", fields: [generatedById], references: [id])

  @@unique([employeeId, month, year])
  @@index([organizationId, year, month])
}

model EmployeeFormInvitation {
  id                     String                  @id
  organizationId         String
  createdById            String
  recipientName          String?
  recipientEmail         String?
  title                  String
  description            String?
  fields                 Json
  tokenHash              String                  @unique
  tokenEncrypted         String?
  expiresAt              DateTime?
  status                 String                  @default("SENT")
  submittedAt            DateTime?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime
  User                   User                    @relation(fields: [createdById], references: [id])
  Organization           Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  EmployeeFormSubmission EmployeeFormSubmission?

  @@index([organizationId, createdAt])
  @@index([organizationId, status])
}

model playing_with_neon {
  id    Int    @id @default(autoincrement())
  name  String
  value Float? @db.Real
}

model AttendanceAnomaly {
  id                                        String            @id
  organizationId                            String
  employeeId                                String?
  attendanceId                              String?
  siteId                                    String?
  type                                      String
  severity                                  String            @default("MEDIUM")
  message                                   String
  metadata                                  Json?
  resolvedAt                                DateTime?
  resolvedById                              String?
  createdAt                                 DateTime          @default(now())
  AttendanceRecord                          AttendanceRecord? @relation(fields: [attendanceId], references: [id], onUpdate: NoAction)
  User_AttendanceAnomaly_employeeIdToUser   User?             @relation("AttendanceAnomaly_employeeIdToUser", fields: [employeeId], references: [id], onUpdate: NoAction)
  Organization                              Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  User_AttendanceAnomaly_resolvedByIdToUser User?             @relation("AttendanceAnomaly_resolvedByIdToUser", fields: [resolvedById], references: [id], onUpdate: NoAction)
  AttendanceSite                            AttendanceSite?   @relation(fields: [siteId], references: [id], onUpdate: NoAction)

  @@index([employeeId, resolvedAt])
  @@index([organizationId, createdAt])
}

model AttendanceCorrection {
  id                                           String            @id
  organizationId                               String
  employeeId                                   String
  attendanceId                                 String?
  requestedCheckInAt                           DateTime?
  requestedCheckOutAt                          DateTime?
  reason                                       String
  status                                       String            @default("PENDING")
  reviewedById                                 String?
  reviewNote                                   String?
  createdAt                                    DateTime          @default(now())
  updatedAt                                    DateTime          @default(now())
  AttendanceRecord                             AttendanceRecord? @relation(fields: [attendanceId], references: [id], onUpdate: NoAction)
  User_AttendanceCorrection_employeeIdToUser   User              @relation("AttendanceCorrection_employeeIdToUser", fields: [employeeId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  Organization                                 Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  User_AttendanceCorrection_reviewedByIdToUser User?             @relation("AttendanceCorrection_reviewedByIdToUser", fields: [reviewedById], references: [id], onUpdate: NoAction)

  @@index([organizationId, status])
}

model AttendancePresenceEvent {
  id               String            @id
  organizationId   String
  employeeId       String
  attendanceId     String?
  siteId           String?
  eventType        String
  recordedAt       DateTime
  latitude         Float?
  longitude        Float?
  gpsAccuracy      Float?
  distanceMeters   Float?
  inside           Boolean?
  clientEventId    String?
  metadata         Json?
  createdAt        DateTime          @default(now())
  AttendanceRecord AttendanceRecord? @relation(fields: [attendanceId], references: [id], onUpdate: NoAction)
  User             User              @relation(fields: [employeeId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  Organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  AttendanceSite   AttendanceSite?   @relation(fields: [siteId], references: [id], onUpdate: NoAction)

  @@index([attendanceId, recordedAt], map: "AttendancePresenceEvent_attendance_recorded_idx")
  @@index([employeeId, recordedAt], map: "AttendancePresenceEvent_employee_recorded_idx")
}

model AttendanceSite {
  id                      String                    @id
  organizationId          String
  name                    String
  address                 String?
  latitude                Decimal                   @db.Decimal(10, 7)
  longitude               Decimal                   @db.Decimal(10, 7)
  radiusMeters            Int                       @default(250)
  timezone                String?
  managerId               String?
  geofenceMode            String                    @default("WARNING")
  qrCode                  String?
  active                  Boolean                   @default(true)
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @default(now())
  projectId               String?
  outsideGraceMinutes     Int                       @default(60)
  autoFinalize            Boolean                   @default(true)
  geofenceType            String                    @default("RADIUS")
  boundary                Json?
  areaSqMeters            Float?
  perimeterMeters         Float?
  AttendanceAnomaly       AttendanceAnomaly[]
  AttendancePresenceEvent AttendancePresenceEvent[]
  User                    User?                     @relation(fields: [managerId], references: [id], onUpdate: NoAction)
  Organization            Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  Project                 Project?                  @relation(fields: [projectId], references: [id], onUpdate: NoAction)
  AttendanceSiteEmployee  AttendanceSiteEmployee[]

  @@index([organizationId, active])
  @@index([projectId])
}

model AttendanceSiteEmployee {
  siteId         String
  employeeId     String
  isPrimary      Boolean        @default(false)
  createdAt      DateTime       @default(now())
  User           User           @relation(fields: [employeeId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  AttendanceSite AttendanceSite @relation(fields: [siteId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([siteId, employeeId])
  @@index([employeeId])
}

model AttendanceSyncEvent {
  id             String       @id
  clientEventId  String       @unique
  organizationId String
  employeeId     String
  eventType      String
  recordedAt     DateTime
  localDate      DateTime     @db.Date
  payload        Json
  status         String       @default("PENDING")
  processedAt    DateTime?
  lastError      String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now())
  User           User         @relation(fields: [employeeId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  Organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([employeeId, status])
  @@index([organizationId, createdAt])
}

model TimeEntry {
  id             String       @id
  organizationId String
  employeeId     String
  projectId      String?
  taskId         String?
  date           DateTime     @db.Date
  hours          Decimal      @db.Decimal(6, 2)
  note           String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime
  User           User         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  Organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  Project        Project?     @relation(fields: [projectId], references: [id])
  Task           Task?        @relation(fields: [taskId], references: [id])

  @@index([employeeId, date])
  @@index([organizationId, date])
  @@index([projectId, date])
  @@index([taskId, date])
}

