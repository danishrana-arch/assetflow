generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Organization {
  id                        String                    @id @default(cuid())
  name                      String
  slug                      String                    @unique
  logoUrl                   String?
  primaryColor              String                    @default("#3E63DD")
  accentColor               String                    @default("#16A34A")
  theme                     String                    @default("light")
  planTier                  PlanTier                  @default(FREE)
  createdAt                 DateTime                  @default(now())
  updatedAt                 DateTime                  @updatedAt
  casualLeaveAllowance      Int                       @default(6)
  // Pro-rata leave pool (utils/leave-policy.js): total paid days a year
  // (sick + casual + annual), earned 1/12 per month from the joining month.
  // Annual leave = this minus the sick and casual allowances.
  annualLeaveEntitlement    Int                       @default(30)
  sickLeaveAllowance        Int                       @default(8)
  lateDeductionAmount       Decimal                   @default(500) @db.Decimal(10, 2)
  // Flat fine per ABSENT day, set from the Attendance page. Null = the
  // salary-banded rate (same as unpaid leave).
  absentFineAmount          Decimal?                  @db.Decimal(10, 2)
  // Attendance & payroll policy (Attendance page → Policy & fines), applied by
  // services/attendance-engine.js. An hours value of 0 turns that rule off.
  // Late by >= lateHalfDayThresholdHours → HALF_DAY; worked < halfDayMinimumHours
  // → HALF_DAY; worked <= earlyGoingThresholdHours → EARLY_GOING (+ fine).
  // A half day deducts halfDayDeductionPercent of the day rate (absentFineAmount).
  lateHalfDayThresholdHours Decimal                   @default(3) @db.Decimal(4, 2)
  halfDayMinimumHours       Decimal                   @default(4.5) @db.Decimal(4, 2)
  earlyGoingThresholdHours  Decimal                   @default(2) @db.Decimal(4, 2)
  earlyGoingFineAmount      Decimal                   @default(0) @db.Decimal(10, 2)
  halfDayDeductionPercent   Decimal                   @default(50) @db.Decimal(5, 2)
  payrollAccountNumber      String?
  payrollBankName           String?
  workingHoursPerDay        Decimal                   @default(8) @db.Decimal(4, 2)
  workingDaysPerWeek        Int                       @default(5)
  // Which weekdays are worked, as UTC weekday numbers (0 Sun … 6 Sat),
  // comma-separated, e.g. "1,2,3,4,5" = Mon–Fri. workingDaysPerWeek is
  // kept equal to the count. See utils/work-schedule.js.
  workingDays               String                    @default("1,2,3,4,5")
  companyId                 String?
  parentOrganizationId      String?
  // DEPRECATED — superseded by hierarchyRole (migrated to PARENT); kept so no
  // data is dropped. Not read by the app.
  isCoMain                  Boolean                   @default(false)
  // GRAND_PARENT / PARENT / CHILD; with parentOrganizationId (the company
  // directly above) this forms the company tree. See utils/organization.js.
  hierarchyRole             OrganizationHierarchyRole @default(CHILD)
  // IT office or call center; call-center admins (User.callCenterAccess)
  // reach every CALL_CENTER of the group. Set by a CEO.
  officeType                OrganizationOfficeType    @default(IT_OFFICE)
  geofenceEnabled           Boolean                   @default(false)
  officeLatitude            Decimal?                  @db.Decimal(10, 7)
  officeLongitude           Decimal?                  @db.Decimal(10, 7)
  geofenceRadiusMeters      Int                       @default(200)
  archivedAt                DateTime?
  shiftStartDefault         String?
  shiftEndDefault           String?
  lateThresholdMinutes      Int                       @default(15)
  breakEnd                  String?
  breakStart                String?
  timezone                  String                    @default("Asia/Karachi")
  remoteOfflineGraceMinutes Int                       @default(30)
  announcements             Announcement[]
  accessGrants              OrganizationAccessGrant[]
  userInvitations           UserInvitation[]
  assets                    Asset[]
  AttendanceAnomaly         AttendanceAnomaly[]
  AttendanceCorrection      AttendanceCorrection[]
  AttendancePermission      AttendancePermission[]
  AttendancePresenceEvent   AttendancePresenceEvent[]
  AttendanceSite            AttendanceSite[]
  AttendanceSyncEvent       AttendanceSyncEvent[]
  auditLogs                 AuditLog[]
  biometricDevices          BiometricDevice[]
  biometricPunches          BiometricPunch[]
  companyEvents             CompanyEvent[]
  departments               Department[]
  employeeDocuments         EmployeeDocument[]
  employeeForms             EmployeeForm[]
  EmployeeFormInvitation    EmployeeFormInvitation[]
  formSubmissions           EmployeeFormSubmission[]
  holidays                  Holiday[]
  latePolicyRules           LatePolicyRule[]
  notifications             Notification[]
  company                   Organization?             @relation("CompanyOrganizations", fields: [companyId], references: [id])
  organizations             Organization[]            @relation("CompanyOrganizations")
  parentOrganization        Organization?             @relation("OrganizationHierarchy", fields: [parentOrganizationId], references: [id])
  childOrganizations        Organization[]            @relation("OrganizationHierarchy")
  performanceReviews        PerformanceReview[]
  projects                  Project[]
  tasks                     Task[]
  tickets                   Ticket[]
  TimeEntry                 TimeEntry[]
  users                     User[]
  workCategories            WorkCategory[]
  subscription              OrganizationSubscription?
  billingInvoices           BillingInvoice[]
  salesInquiries            SalesInquiry[]
  featureOverrides          OrganizationFeatureOverride[]

  @@index([companyId])
  @@index([parentOrganizationId])
  @@index([archivedAt])
}

model Announcement {
  id             String       @id @default(cuid())
  organizationId String
  createdById    String?
  title          String
  body           String
  audienceType   String       @default("ALL")
  audienceId     String?
  publishedAt    DateTime     @default(now())
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  createdBy      User?        @relation("AnnouncementCreator", fields: [createdById], references: [id], onDelete: SetNull)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, publishedAt])
  @@index([audienceType, audienceId])
}

model CompanyEvent {
  id             String       @id @default(cuid())
  organizationId String
  createdById    String?
  title          String
  date           DateTime     @db.Date
  description    String?
  type           String       @default("ANNUAL_EVENT")
  isAnnual       Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  createdBy      User?        @relation("CompanyEventCreator", fields: [createdById], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, date])
  @@index([organizationId, type])
}

model Holiday {
  id             String       @id @default(cuid())
  organizationId String
  date           DateTime     @db.Date
  name           String
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, date])
  @@index([organizationId])
}

model AuditLog {
  id             String       @id @default(cuid())
  organizationId String
  actorId        String?
  action         String
  targetType     String?
  targetId       String?
  note           String?
  // Structured before/after values for platform actions: { before, after, ... }.
  details        Json?
  createdAt      DateTime     @default(now())
  actor          User?        @relation(fields: [actorId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, createdAt])
}

model User {
  id                                                           String                    @id @default(cuid())
  organizationId                                               String
  name                                                         String
  email                                                        String                    @unique
  password                                                     String
  // Nonce behind the personal .ics calendar feed URL (Google/Outlook
  // subscribe); the URL carries an HMAC of it, never the nonce itself.
  // Regenerated on "reset link"; null until first requested.
  calendarFeedToken                                            String?                   @unique
  phone                                                        String?
  photoUrl                                                     String?
  role                                                         UserRole                  @default(EMPLOYEE)
  // Optional platform-defined role (CustomRole): its module list replaces the
  // base role's modules; `role` stays the base role for every other check.
  customRoleId                                                 String?
  customRole                                                   CustomRole?               @relation(fields: [customRoleId], references: [id], onDelete: SetNull)
  status                                                       EmployeeStatus            @default(ACTIVE)
  departmentId                                                 String?
  managerId                                                    String?
  cnic                                                         String?
  dob                                                          DateTime?
  address                                                      String?
  skill                                                        String?
  seniorityLevel                                               SeniorityLevel?
  canManageAttendance                                          Boolean                   @default(false)
  createdAt                                                    DateTime                  @default(now())
  updatedAt                                                    DateTime                  @updatedAt
  baseSalary                                                   Decimal?                  @db.Decimal(12, 2)
  bankAccountNumber                                            String?
  bankName                                                     String?
  designation                                                  String?
  joiningDate                                                  DateTime?
  workLocationType                                             WorkLocationType          @default(OFFICE)
  personalEmail                                                String?
  fatherName                                                   String?
  education                                                    String?
  currentUniversity                                            String?
  linkedinUrl                                                  String?
  shiftStart                                                   String?
  shiftEnd                                                     String?
  // Joining = joined the company; start = started the assigned operation /
  // campaign / position (often later, e.g. call centers). Kept separate.
  startDate                                                    DateTime?
  // Leave applications need PERMANENT; paid leave accrues pro-rata from the
  // joining month (see utils/leave-policy.js).
  employmentStatus                                             EmploymentStatus          @default(PROBATION)
  permanentDate                                                DateTime?                 @db.Date
  // passportNumber / civilNumber / emergency phones+address are encrypted
  // at rest (utils/crypto.js), same as CNIC.
  passportNumber                                               String?
  civilNumber                                                  String?
  nationality                                                  String?
  agentName                                                    String?
  emergencyContactName                                         String?
  emergencyContactRelationship                                 String?
  emergencyContactPhone                                        String?
  emergencyContactAltPhone                                     String?
  emergencyContactAddress                                      String?
  emergencyContactNotes                                        String?
  documents                                                    EmployeeDocument[]        @relation("EmployeeDocumentOf")
  documentsUploaded                                            EmployeeDocument[]        @relation("EmployeeDocumentUploader")
  leaveApplicationsHrReviewed                                  LeaveApplication[]        @relation("LeaveHrReviewer")
  // ADMIN only, set by a CEO: may open every call center of the company
  // group (and no IT office). See utils/organization.js.
  callCenterAccess                                             Boolean                   @default(false)
  failedLoginAttempts                                          Int                       @default(0)
  lastFailedLoginAt                                            DateTime?
  securityAlertSentAt                                          DateTime?
  passwordResetTokens                                          PasswordResetToken[]
  invitation                                                   UserInvitation?           @relation("InvitationUser")
  invitationsSent                                              UserInvitation[]          @relation("InvitationInviter")
  accessGrants                                                 OrganizationAccessGrant[] @relation("AccessGrantUser")
  accessGrantsGiven                                            OrganizationAccessGrant[] @relation("AccessGrantGrantedBy")
  announcementsCreated                                         Announcement[]            @relation("AnnouncementCreator")
  assignedAssets                                               Asset[]                   @relation("AssignedAssets")
  assetRequests                                                AssetRequest[]            @relation("AssetRequestedBy")
  assetRequestsReviewed                                        AssetRequest[]            @relation("AssetRequestReviewer")
  AttendanceAnomaly_AttendanceAnomaly_employeeIdToUser         AttendanceAnomaly[]       @relation("AttendanceAnomaly_employeeIdToUser")
  AttendanceAnomaly_AttendanceAnomaly_resolvedByIdToUser       AttendanceAnomaly[]       @relation("AttendanceAnomaly_resolvedByIdToUser")
  AttendanceCorrection_AttendanceCorrection_employeeIdToUser   AttendanceCorrection[]    @relation("AttendanceCorrection_employeeIdToUser")
  AttendanceCorrection_AttendanceCorrection_reviewedByIdToUser AttendanceCorrection[]    @relation("AttendanceCorrection_reviewedByIdToUser")
  AttendancePresenceEvent                                      AttendancePresenceEvent[] @relation("PresenceEventEmployee")
  presenceEventsActed                                          AttendancePresenceEvent[] @relation("PresenceEventActor")
  attendanceCorrectionsRequested                               AttendanceCorrection[]    @relation("AttendanceCorrectionRequestedBy")
  siteAdminAssignments                                         AttendanceSiteAdmin[]     @relation("SiteAdminOf")
  siteAdminAssignmentsGiven                                    AttendanceSiteAdmin[]     @relation("SiteAdminAssignedBy")
  payrollAdjustmentsMade                                       PayrollAdjustment[]       @relation("PayrollAdjustmentBy")
  salaryRevisions                                              SalaryRevision[]          @relation("SalaryRevisionOf")
  salaryRevisionsMade                                          SalaryRevision[]          @relation("SalaryRevisionBy")
  attendanceRecords                                           AttendanceRecord[]        @relation("AttendanceOf")
  attendanceMarkedBy                                           AttendanceRecord[]        @relation("AttendanceMarkedBy")
  attendanceNotes                                              AttendanceNote[]          @relation("AttendanceNoteEmployee")
  attendanceFines                                              AttendanceFine[]          @relation("AttendanceFineEmployee")
  attendanceFinesUpdated                                       AttendanceFine[]          @relation("AttendanceFineUpdatedBy")
  attendanceNotesWritten                                       AttendanceNote[]          @relation("AttendanceNoteAuthor")
  AttendanceSite                                               AttendanceSite[]
  AttendanceSiteEmployee                                       AttendanceSiteEmployee[]
  AttendanceSyncEvent                                          AttendanceSyncEvent[]
  auditLogs                                                    AuditLog[]
  biometricMappings                                            BiometricDeviceEmployee[]
  biometricPunches                                             BiometricPunch[]
  certifications                                               Certification[]
  companyEvents                                                CompanyEvent[]            @relation("CompanyEventCreator")
  managedDepartments                                           Department[]              @relation("DepartmentManager")
  employeeFormsCreated                                         EmployeeForm[]            @relation("EmployeeFormCreator")
  EmployeeFormInvitation                                       EmployeeFormInvitation[]
  formSubmissionsConverted                                     EmployeeFormSubmission[]  @relation("FormSubmissionEmployee")
  leaveApplications                                            LeaveApplication[]        @relation("LeaveApplicant")
  leaveApplicationsReviewed                                    LeaveApplication[]        @relation("LeaveReviewer")
  lifecycleEvents                                              LifecycleEvent[]          @relation("EventActor")
  notificationsCreated                                         Notification[]            @relation("NotificationCreator")
  notifications                                                Notification[]            @relation("NotificationRecipient")
  payrollApprovedBy                                            PayrollRecord[]           @relation("PayrollApprovedBy")
  payrollRecords                                               PayrollRecord[]           @relation("PayrollOf")
  payrollGeneratedBy                                           PayrollRecord[]           @relation("PayrollGeneratedBy")
  expenseClaims                                                ExpenseClaim[]            @relation("ExpenseClaimOf")
  expenseClaimsReviewed                                        ExpenseClaim[]            @relation("ExpenseClaimReviewer")
  performanceReviews                                           PerformanceReview[]       @relation("PerformanceEmployee")
  performanceGiven                                             PerformanceReview[]       @relation("PerformanceReviewer")
  managedProjects                                              Project[]                 @relation("ProjectManager")
  projectMemberships                                           ProjectMember[]
  assignedTasks                                                Task[]                    @relation("TaskAssignee")
  createdTasks                                                 Task[]                    @relation("TaskCreator")
  tickets                                                      Ticket[]                  @relation("TicketRaisedBy")
  TimeEntry                                                    TimeEntry[]
  department                                                   Department?               @relation(fields: [departmentId], references: [id])
  manager                                                      User?                     @relation("ManagerReports", fields: [managerId], references: [id])
  reports                                                      User[]                    @relation("ManagerReports")
  organization                                                 Organization              @relation(fields: [organizationId], references: [id])
}

// One-time "forgot password" link. Only a SHA-256 hash of the token is
// stored; the raw token only ever exists in the emailed link.
// A CEO's explicit "this ADMIN / IT_MANAGER may open this company" (on top
// of the hierarchy rules — see utils/organization.js).
model OrganizationAccessGrant {
  id             String       @id @default(cuid())
  userId         String
  organizationId String
  grantedById    String?
  createdAt      DateTime     @default(now())
  user           User         @relation("AccessGrantUser", fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  grantedBy      User?        @relation("AccessGrantGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Email invitation for a new employee: the account is created up front (role,
// department, manager… set by ADMIN/CEO/HR) and the emailed one-time link lets
// the person set their own password and sign straight in. Only a SHA-256 hash
// of the link token is stored.
model UserInvitation {
  id             String       @id @default(cuid())
  organizationId String
  userId         String       @unique
  invitedById    String?
  tokenHash      String       @unique
  expiresAt      DateTime
  acceptedAt     DateTime?
  message        String?
  lastSentAt     DateTime     @default(now())
  sendCount      Int          @default(1)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation("InvitationUser", fields: [userId], references: [id], onDelete: Cascade)
  invitedBy      User?        @relation("InvitationInviter", fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
}

model Notification {
  id             String       @id @default(cuid())
  organizationId String
  recipientId    String
  createdById    String?
  type           String       @default("INFO")
  title          String
  message        String?
  link           String?
  createdAt      DateTime     @default(now())
  readAt         DateTime?
  createdBy      User?        @relation("NotificationCreator", fields: [createdById], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  recipient      User         @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId, readAt, createdAt])
  @@index([organizationId, createdAt])
}

model Certification {
  id            String    @id @default(cuid())
  employeeId    String
  name          String
  institute     String
  credentialId  String?
  credentialUrl String?
  issuedDate    DateTime?
  expiryDate    DateTime?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  employee      User      @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
}

model EmployeeForm {
  id             String                   @id @default(cuid())
  organizationId String
  createdById    String?
  title          String
  tokenHash      String                   @unique
  tokenEncrypted String?
  active         Boolean                  @default(true)
  expiresAt      DateTime?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  createdBy      User?                    @relation("EmployeeFormCreator", fields: [createdById], references: [id])
  organization   Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  submissions    EmployeeFormSubmission[]

  @@index([organizationId, active])
}

model EmployeeFormSubmission {
  id                     String                       @id @default(cuid())
  invitationId           String?                      @unique
  organizationId         String
  data                   Json?
  submittedAt            DateTime                     @default(now())
  createdAt              DateTime                     @default(now())
  updatedAt              DateTime                     @updatedAt
  formId                 String?
  name                   String?
  fatherName             String?
  personalEmail          String?
  phone                  String?
  address                String?
  cnic                   String?
  dob                    DateTime?
  education              String?
  currentUniversity      String?
  seniorityLevel         SeniorityLevel?
  companyEmail           String?
  linkedinUrl            String?
  notes                  String?
  status                 EmployeeFormSubmissionStatus @default(SUBMITTED)
  convertedEmployeeId    String?
  convertedEmployee      User?                        @relation("FormSubmissionEmployee", fields: [convertedEmployeeId], references: [id])
  form                   EmployeeForm?                @relation(fields: [formId], references: [id], onDelete: Cascade)
  EmployeeFormInvitation EmployeeFormInvitation?      @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  organization           Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([formId, submittedAt])
  @@index([organizationId, status])
  @@index([organizationId, submittedAt])
}

model LeaveApplication {
  id             String      @id @default(cuid())
  organizationId String
  employeeId     String
  startDate      DateTime    @db.Date
  endDate        DateTime    @db.Date
  reason         String
  type           LeaveType   @default(CASUAL)
  isHalfDay      Boolean     @default(false)
  // Decided at final approval (ADMIN/CEO): PAID = uses the leave balance,
  // marked LEAVE; UNPAID = days marked ABSENT and charged the absent fine
  // (half-day: half the fine). Null until approved; UNPAID-type requests are
  // always UNPAID.
  payAs          String?
  status         LeaveStatus @default(PENDING_HR)
  // Step 1: HR decision (PENDING_HR → PENDING_FINAL_APPROVAL / REJECTED).
  hrReviewedById String?
  hrReviewedAt   DateTime?
  hrReviewNote   String?
  // Step 2 (final): ADMIN or CEO decision — or the HR rejection, when the
  // request never reached step 2.
  reviewedById   String?
  reviewedAt     DateTime?
  reviewNote     String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  employee       User        @relation("LeaveApplicant", fields: [employeeId], references: [id], onDelete: Cascade)
  reviewedBy     User?       @relation("LeaveReviewer", fields: [reviewedById], references: [id])
  hrReviewedBy   User?       @relation("LeaveHrReviewer", fields: [hrReviewedById], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([employeeId])
}

// Employee document pictures (passport, civil ID, …). Stored in the DB
// (the API has no file storage and its hosts' disks are ephemeral); served
// only through GET /employees/:id/documents/:docId with the profile's
// visibility rules.
model EmployeeDocument {
  id             String               @id @default(cuid())
  organizationId String
  employeeId     String
  kind           EmployeeDocumentKind @default(OTHER)
  label          String?
  fileName       String
  mimeType       String
  size           Int
  data           Bytes
  uploadedById   String?
  createdAt      DateTime             @default(now())
  employee       User                 @relation("EmployeeDocumentOf", fields: [employeeId], references: [id], onDelete: Cascade)
  uploadedBy     User?                @relation("EmployeeDocumentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([employeeId, kind])
}

model AssetRequest {
  id               String             @id @default(cuid())
  organizationId   String
  employeeId       String
  category         String
  reason           String
  status           AssetRequestStatus @default(PENDING)
  reviewedById     String?
  reviewedAt       DateTime?
  reviewNote       String?
  fulfilledAssetId String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  employee         User               @relation("AssetRequestedBy", fields: [employeeId], references: [id], onDelete: Cascade)
  fulfilledAsset   Asset?             @relation(fields: [fulfilledAssetId], references: [id])
  reviewedBy       User?              @relation("AssetRequestReviewer", fields: [reviewedById], references: [id])

  @@index([organizationId, status])
  @@index([employeeId])
}

model Department {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  createdAt      DateTime     @default(now())
  managerId      String?
  assets         Asset[]
  manager        User?        @relation("DepartmentManager", fields: [managerId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id])
  employees      User[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([managerId])
}

model Asset {
  id                String           @id @default(cuid())
  organizationId    String
  name              String
  category          String?
  serialNumber      String           @unique
  cpu               String?
  ram               String?
  storage           String?
  purchaseDate      DateTime?
  warrantyEnd       DateTime?
  status            AssetStatus      @default(AVAILABLE)
  departmentId      String?
  assignedToId      String?
  photos            String[]         @default([])
  documents         String[]         @default([])
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  assignedTo        User?            @relation("AssignedAssets", fields: [assignedToId], references: [id])
  department        Department?      @relation(fields: [departmentId], references: [id])
  organization      Organization     @relation(fields: [organizationId], references: [id])
  fulfilledRequests AssetRequest[]
  lifecycleEvents   LifecycleEvent[]
  tickets           Ticket[]
}

model LifecycleEvent {
  id         String             @id @default(cuid())
  assetId    String
  type       LifecycleEventType
  note       String?
  actorId    String?
  occurredAt DateTime           @default(now())
  cost       Decimal?           @db.Decimal(10, 2)
  actor      User?              @relation("EventActor", fields: [actorId], references: [id])
  asset      Asset              @relation(fields: [assetId], references: [id])
}

model Project {
  id                        String           @id @default(cuid())
  organizationId            String
  name                      String
  description               String?
  clientName                String?
  projectUrl                String?
  status                    ProjectStatus    @default(NOT_STARTED)
  startDate                 DateTime?        @db.Date
  deadline                  DateTime?        @db.Date
  completedAt               DateTime?
  totalHours                Decimal          @default(0) @db.Decimal(10, 2)
  managerId                 String?
  createdAt                 DateTime         @default(now())
  updatedAt                 DateTime         @updatedAt
  technologies              String[]         @default([])
  deadlineReminderSentAt    DateTime?
  deadlineOverdueNotifiedAt DateTime?
  workCategoryId            String?
  AttendanceSite            AttendanceSite[]
  manager                   User?            @relation("ProjectManager", fields: [managerId], references: [id])
  organization              Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workCategory              WorkCategory?    @relation(fields: [workCategoryId], references: [id])
  members                   ProjectMember[]
  tasks                     Task[]
  TimeEntry                 TimeEntry[]

  @@index([organizationId, status])
  @@index([organizationId, deadline])
}

model ProjectMember {
  id         String   @id @default(cuid())
  projectId  String
  employeeId String
  hoursSpent Decimal  @default(0) @db.Decimal(10, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  employee   User     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, employeeId])
