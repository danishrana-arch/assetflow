model BiometricDevice {
  id                      String                    @id @default(cuid())
  organizationId          String
  name                    String
  vendor                  BiometricVendor
  model                   String?
  // Unique per organization, not globally: serial numbers can genuinely
  // collide across different vendors/batches, so treating them as globally
  // unique would be wrong. Multi-tenancy for ADMS is resolved by the
  // organization slug in the URL path instead (see adms.controller.js) —
  // the device is looked up by serialNumber only within that organization.
  serialNumber            String?
  ipAddress               String?
  port                    Int?
  connectionMode          BiometricConnectionMode   @default(PULL)
  enabled                 Boolean                   @default(true)
  doorEnabled             Boolean                   @default(false)
  unlockSeconds           Int                       @default(5)
  relayUrl                String?
  relaySecret             String?
  communicationKey        String?
  connectorTokenHash      String?
  connectorTokenCreatedAt DateTime?
  lastSeenAt              DateTime?
  lastSyncAt              DateTime?
  lastError               String?
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  organization            Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  mappings                BiometricDeviceEmployee[]
  punches                 BiometricPunch[]

  @@unique([organizationId, serialNumber])
  @@index([organizationId])
}

model BiometricDeviceEmployee {
  id             String          @id @default(cuid())
  deviceId       String
  employeeId     String
  externalUserId String
  createdAt      DateTime        @default(now())
  device         BiometricDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  employee       User            @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([deviceId, externalUserId])
  @@unique([deviceId, employeeId])
  @@index([employeeId])
}

model BiometricPunch {
  id             String          @id @default(cuid())
  organizationId String
  deviceId       String
  employeeId     String?
  externalUserId String
  occurredAt     DateTime
  verification   String?
  // The device's own IN/OUT function-key press, when the protocol tells us
  // (ADMS's ATTLOG Status field: "IN" or "OUT"). Null when a device/path
  // doesn't report it — those punches fall back to ordering (first punch of
  // the day = in, last = out) for check-in/check-out purposes.
  direction      String?
  externalId     String?
  rawPayload     Json?
  createdAt      DateTime        @default(now())
  fingerprint    String?         @unique
  device         BiometricDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  employee       User?           @relation(fields: [employeeId], references: [id])
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([deviceId, externalId])
  @@index([organizationId, occurredAt])
  @@index([deviceId, occurredAt])
}

model AttendanceRecord {
  id                      String                    @id @default(cuid())
  organizationId          String
  employeeId              String
  date                    DateTime                  @db.Date
  status                  AttendanceStatus          @default(PRESENT)
  markedById              String?
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  source                  AttendanceSource          @default(MANUAL)
  biometricDeviceId       String?
  checkInAt               DateTime?
  checkOutAt              DateTime?
  workingMinutes          Int?
  latitude                Decimal?                  @db.Decimal(10, 7)
  longitude               Decimal?                  @db.Decimal(10, 7)
  distanceMeters          Int?
  autoFlagged             Boolean                   @default(false)
  siteId                  String?
  offlineRecorded         Boolean                   @default(false)
  localRecordedAt         DateTime?
  syncedAt                DateTime?
  clientEventId           String?
  gpsAccuracy             Float?
  networkType             String?
  attendanceDeviceId      String?
  verificationHash        String?
  // Per-day mode chosen at check-in (distinct from the employee's fixed
  // User.workLocationType classification). WFH skips the geofence check
  // entirely at mark time.
  locationMode            AttendanceLocationMode    @default(OFFICE)
  // Shift-end checkout reminder already sent (attendance-checkout.service.js).
  checkoutReminderSentAt  DateTime?
  // Check-out filled in by the system at shift end because the employee
  // never checked out that day.
  autoCheckedOut          Boolean                   @default(false)
  // The employee's own note on their day (e.g. extra hours worked), separate
  // from the HR/ADMIN/CEO AttendanceNote. extraMinutes = extra time claimed.
  employeeNote            String?
  extraMinutes            Int?
  // HR/ADMIN/CEO marked the employee's note as seen (Attendance page).
  employeeNoteSeenAt      DateTime?
  employeeNoteSeenById    String?
  // Result of the attendance engine (services/attendance-engine.js), written
  // on every check-in/out, admin mark, correction, biometric sync and site
  // admin action. Payroll reads these instead of recalculating. A null
  // dayType = no half-day/early-going rule applied (full day, leave,
  // absent, non-workday, or not checked out yet).
  scheduledStartAt        DateTime?
  scheduledEndAt          DateTime?
  lateMinutes             Int?
  earlyGoingMinutes       Int?
  dayType                 AttendanceDayType?
  dayTypeReason           String?
  // Days deducted for a HALF_DAY / EARLY_GOING day (halfDayDeductionPercent / 100).
  deductionDays           Decimal?                  @db.Decimal(4, 2)
  // Early-going fine snapshot (Organization.earlyGoingFineAmount at evaluation).
  earlyGoingFine          Decimal?                  @db.Decimal(10, 2)
  evaluatedAt             DateTime?
  // Site of the check-out when it differs from the check-in site (siteId).
  checkOutSiteId          String?
  AttendanceAnomaly       AttendanceAnomaly[]
  AttendanceCorrection    AttendanceCorrection[]
  AttendancePresenceEvent AttendancePresenceEvent[]
  employee                User                      @relation("AttendanceOf", fields: [employeeId], references: [id], onDelete: Cascade)
  markedBy                User?                     @relation("AttendanceMarkedBy", fields: [markedById], references: [id])

  @@unique([employeeId, date])
  @@index([organizationId, date])
  @@index([biometricDeviceId])
  @@index([offlineRecorded])
  @@index([siteId, date])
}

// Free-text note on an employee's day, written by HR/ADMIN/CEO from the
// Attendance page. Separate from AttendanceRecord so adding a note never
// creates an attendance record (which would change the day's status).
model AttendanceNote {
  id             String   @id @default(cuid())
  organizationId String
  employeeId     String
  date           DateTime @db.Date
  note           String
  authorId       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  employee       User     @relation("AttendanceNoteEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  author         User?    @relation("AttendanceNoteAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@unique([employeeId, date])
  @@index([organizationId, date])
}

// Fine decisions for one employee's day, set by HR/ADMIN/CEO from the
// Attendance page. The automatic late/absent fine comes from the day's
// status (payroll rules); `waived` cancels it for this day, `extraAmount`
// adds a manual fine. Payroll reads these when (re)generating a payslip.
model AttendanceFine {
  id             String   @id @default(cuid())
  organizationId String
  employeeId     String
  date           DateTime @db.Date
  waived         Boolean  @default(false)
  extraAmount    Decimal  @default(0) @db.Decimal(10, 2)
  reason         String?
  updatedById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  employee       User     @relation("AttendanceFineEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  updatedBy      User?    @relation("AttendanceFineUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([employeeId, date])
  @@index([organizationId, date])
}

model PayrollRecord {
  id                    String        @id @default(cuid())
  organizationId        String
  employeeId            String
  month                 Int
  year                  Int
  baseSalary            Decimal       @db.Decimal(12, 2)
  bonus                 Decimal       @default(0) @db.Decimal(12, 2)
  deductions            Decimal       @default(0) @db.Decimal(12, 2)
  unpaidLeaveDays       Int           @default(0)
  netPay                Decimal       @db.Decimal(12, 2)
  status                PayrollStatus @default(DRAFT)
  note                  String?
  generatedById         String?
  paidAt                DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  approvedAt            DateTime?
  approvedById          String?
  bankAccountNumber     String?
  bankName              String?
  halfDayLeaveDays      Int           @default(0)
  lateDays              Int           @default(0)
  // Workdays marked ABSENT in attendance (no check-in / admin-marked),
  // deducted at the same daily rate as unpaid leave into absentDeduction.
  absentDays            Int           @default(0)
  // Payslip breakdown. `deductions` stays the TOTAL of every deduction
  // below (tax + absent + late + other + termination) so existing
  // summaries keep working; netPay = base + bonus + expenseReimbursement
  // + terminationSettlement - deductions.
  // tax = baseSalary x taxPercent / 100, recomputed whenever the admin
  // changes the percentage.
  tax                   Decimal       @default(0) @db.Decimal(12, 2)
  taxPercent            Decimal       @default(0) @db.Decimal(5, 2)
  absentDeduction       Decimal       @default(0) @db.Decimal(12, 2)
  lateDeduction         Decimal       @default(0) @db.Decimal(12, 2)
  // Manual attendance fines (AttendanceFine.extraAmount) for the month.
  fineDeduction         Decimal       @default(0) @db.Decimal(12, 2)
  otherDeduction        Decimal       @default(0) @db.Decimal(12, 2)
  // Sum of this employee's APPROVED expense claims assigned to this month.
  expenseReimbursement  Decimal       @default(0) @db.Decimal(12, 2)
  // Sum of this employee's performance-review bonuses assigned to this month.
  performanceBonus      Decimal       @default(0) @db.Decimal(12, 2)
  terminationDate       DateTime?
  terminationSettlement Decimal       @default(0) @db.Decimal(12, 2)
  terminationDeduction  Decimal       @default(0) @db.Decimal(12, 2)
  terminationNote       String?
  // From the attendance engine: days marked HALF_DAY / EARLY_GOING, their
  // day-rate deduction, and the early-going fines.
  halfDays              Int           @default(0)
  halfDayDeduction      Decimal       @default(0) @db.Decimal(12, 2)
  // Late-arrival rules (LatePolicyRule): day-equivalents charged to salary,
  // their amount, and days taken from the leave balance instead.
  latePenaltyDays       Decimal       @default(0) @db.Decimal(6, 2)
  latePenaltyDeduction  Decimal       @default(0) @db.Decimal(12, 2)
  latePenaltyLeaveDays  Decimal       @default(0) @db.Decimal(6, 2)
  earlyGoingDays        Int           @default(0)
  earlyGoingFine        Decimal       @default(0) @db.Decimal(12, 2)
  // Sum of PayrollAdjustment.amount (excluding FIELD_EDIT rows, which are
  // already in the edited field). Added to net pay; + raises it.
  adjustmentTotal       Decimal       @default(0) @db.Decimal(12, 2)
  adjustments           PayrollAdjustment[]
  approvedBy            User?         @relation("PayrollApprovedBy", fields: [approvedById], references: [id])
  employee              User          @relation("PayrollOf", fields: [employeeId], references: [id], onDelete: Cascade)
  generatedBy           User?         @relation("PayrollGeneratedBy", fields: [generatedById], references: [id])

  @@unique([employeeId, month, year])
  @@index([organizationId, year, month])
}

// Audit trail of every manual change to a payslip after it's generated.
// Rows are never edited or deleted (except with the payslip itself); undoing
// one adds a REVERSAL row. `amount` is the effect on net pay (+ raises it).
// type: REMOVE_FINE / REDUCE_FINE / ADD_FINE / ADD_DEDUCTION /
// REMOVE_DEDUCTION / ALLOWANCE / ATTENDANCE_CORRECTION / OTHER / REVERSAL
// (summed into PayrollRecord.adjustmentTotal), or FIELD_EDIT (a direct edit
// of bonus / tax % / other deduction / termination — logged, not summed).
model PayrollAdjustment {
  id                String             @id @default(cuid())
  organizationId    String
  payrollRecordId   String
  employeeId        String
  type              String
  // Payslip line the change is about (e.g. lateDeduction, bonus), if any.
  line              String?
  amount            Decimal            @db.Decimal(12, 2)
  originalValue     Decimal?           @db.Decimal(12, 2)
  newValue          Decimal?           @db.Decimal(12, 2)
  previousNetPay    Decimal            @db.Decimal(12, 2)
  newNetPay         Decimal            @db.Decimal(12, 2)
  reason            String
  payslipStatus     PayrollStatus
  // Made on a PAID (finalized) payslip through the explicit CEO override.
  finalizedOverride Boolean            @default(false)
  reversesId        String?            @unique
  createdById       String?
  createdAt         DateTime           @default(now())
  payrollRecord     PayrollRecord      @relation(fields: [payrollRecordId], references: [id], onDelete: Cascade)
  createdBy         User?              @relation("PayrollAdjustmentBy", fields: [createdById], references: [id], onDelete: SetNull)
  reverses          PayrollAdjustment? @relation("PayrollAdjustmentReversal", fields: [reversesId], references: [id], onDelete: SetNull)
  reversedBy        PayrollAdjustment? @relation("PayrollAdjustmentReversal")

  @@index([payrollRecordId, createdAt])
  @@index([organizationId, createdAt])
}

// History of every change to an employee's base salary (User.baseSalary):
// increments / decrements from the Payroll page or the profile, and direct
// edits of the salary field on the profile (source PROFILE_EDIT). Rows are
// never edited. type: INCREMENT / DECREMENT / SET (first salary set).
// changeAmount is signed (+ raise, - cut); changePercent is what was entered
// when the change was given as a percentage. Effective from
// effectiveMonth/effectiveYear: DRAFT payslips from that month on were
// updated (payslipsUpdated); submitted/paid ones are never changed.
model SalaryRevision {
  id              String   @id @default(cuid())
  organizationId  String
  employeeId      String
  type            String
  previousSalary  Decimal? @db.Decimal(12, 2)
  newSalary       Decimal  @db.Decimal(12, 2)
  changeAmount    Decimal  @db.Decimal(12, 2)
  changePercent   Decimal? @db.Decimal(6, 2)
  effectiveMonth  Int
  effectiveYear   Int
  reason          String
  source          String   @default("PAYROLL")
  payslipsUpdated Int      @default(0)
  createdById     String?
  createdAt       DateTime @default(now())
  employee        User     @relation("SalaryRevisionOf", fields: [employeeId], references: [id], onDelete: Cascade)
  createdBy       User?    @relation("SalaryRevisionBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([employeeId, createdAt])
  @@index([organizationId, createdAt])
}

// A company's own late-arrival rule, e.g. "every 3 late arrivals in a month
// count as a half day". Rules are applied per employee per calendar month,
// largest lateCount first, each using up its late arrivals (so with 6→full
// and 3→half, 7 lates = one full day). result: HALF_DAY / FULL_DAY.
// deductFrom: LEAVE (annual leave balance — salary when none is left) or
// SALARY (day rate = Organization.absentFineAmount; half day uses
// halfDayDeductionPercent). replaceLateFine: the late arrivals a rule uses
// aren't also charged the per-late fine. See utils/late-rules.js.
model LatePolicyRule {
  id              String       @id @default(cuid())
  organizationId  String
  name            String
  active          Boolean      @default(true)
  lateCount       Int
  result          String       @default("HALF_DAY")
  deductFrom      String       @default("LEAVE")
  replaceLateFine Boolean      @default(true)
  createdById     String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

// An office expense an employee paid out of pocket (e.g. tea/supplies
// office management forgot). HR/ADMIN/CEO verify it; once APPROVED it's
// assigned to a payroll month (payrollMonth/payrollYear) and added to that
// month's payslip as a reimbursement.
model ExpenseClaim {
  id             String             @id @default(cuid())
  organizationId String
  employeeId     String
  title          String
  amount         Decimal            @db.Decimal(12, 2)
  description    String?
  expenseDate    DateTime
  status         ExpenseClaimStatus @default(PENDING)
  payrollMonth   Int?
  payrollYear    Int?
  reviewedById   String?
  reviewedAt     DateTime?
  reviewNote     String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  employee       User               @relation("ExpenseClaimOf", fields: [employeeId], references: [id], onDelete: Cascade)
  reviewedBy     User?              @relation("ExpenseClaimReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([employeeId, payrollYear, payrollMonth])
}

model EmployeeFormInvitation {
