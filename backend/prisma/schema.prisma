// ── Billing & subscription ───────────────────────────────────────────────
// Plans are data, not code: the Billing page reads them from here. Money is
// stored in minor units (cents). A sale is a percentage off the monthly price
// between saleStartsAt and saleEndsAt (either may be null = open-ended).
model BillingPlan {
  id            String    @id @default(cuid())
  key           String    @unique
  name          String
  description   String    @default("")
  priceCents    Int       @default(0)
  currency      String    @default("usd")
  // null = no cap (Custom plans are sized per customer).
  employeeLimit Int?
  // Custom plans are sold by contacting the team, never by checkout.
  isCustom      Boolean   @default(false)
  features      String[]
  // Entitlement: which platform features (utils/features.js) the plan includes.
  featureKeys   String[]  @default([])
  // Other limits (null = no cap). Only employeeLimit is enforced today; the
  // rest drive the usage warnings in the Control Center.
  siteLimit         Int?
  projectLimit      Int?
  organizationLimit Int?
  storageLimitMb    Int?
  billingInterval   String  @default("MONTH")
  stripePriceId     String?
  recommended   Boolean   @default(false)
  active        Boolean   @default(true)
  sortOrder     Int       @default(0)
  salePercent   Int?
  saleLabel     String?
  saleStartsAt  DateTime?
  saleEndsAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  subscriptions OrganizationSubscription[]
}

// One row per organization. No row = the Free plan.
model OrganizationSubscription {
  id                   String    @id @default(cuid())
  organizationId       String    @unique
  planId               String
  status               String    @default("ACTIVE")
  // Monthly price (after any sale) locked in when the plan was chosen.
  priceCents           Int       @default(0)
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  stripeCustomerId     String?
  stripeSubscriptionId String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         BillingPlan  @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([planId])
}

// Filled by the payment provider's webhooks once connected.
model BillingInvoice {
  id              String    @id @default(cuid())
  organizationId  String
  number          String
  amountCents     Int
  currency        String    @default("usd")
  status          String    @default("PAID")
  description     String?
  issuedAt        DateTime  @default(now())
  paidAt          DateTime?
  hostedUrl       String?
  pdfUrl          String?
  stripeInvoiceId String?   @unique
  createdAt       DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, issuedAt])
}

// "Contact Our Team" requests from the Custom plan.
model SalesInquiry {
  id             String   @id @default(cuid())
  organizationId String
  requestedById  String?
  name           String
  email          String
  company        String?
  employeeCount  Int?
  message        String
  status         String   @default("NEW")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([status])
}

// Platform-wide switch for a feature (utils/features.js). No row = available.
model PlatformFeature {
  key         String   @id
  enabled     Boolean  @default(true)
  updatedById String?
  updatedAt   DateTime @updatedAt
}

// Per-organization exception to what the plan includes (on or off).
model OrganizationFeatureOverride {
  id             String   @id @default(cuid())
  organizationId String
  featureKey     String
  enabled        Boolean
  note           String?
  updatedById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, featureKey])
}

// A role defined in the Control Center: a named set of modules layered on a
// base role (the base role keeps deciding every non-module check).
model CustomRole {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String   @default("")
  baseRole    UserRole @default(EMPLOYEE)
  modules     String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users User[]
}
