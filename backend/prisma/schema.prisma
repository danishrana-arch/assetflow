model AttendancePresenceEvent {
  id               String            @id
  organizationId   String
  employeeId       String
  attendanceId     String?
  siteId           String?
  eventType        String
  recordedAt       DateTime
  latitude         Float?
  longitude        Float?
  gpsAccuracy      Float?
  distanceMeters   Float?
  inside           Boolean?
  clientEventId    String?
  metadata         Json?
  // Who performed the action when it wasn't the employee (Site Admin
  // attendance marking), and the site's project at that moment.
  actorId          String?
  projectId        String?
  createdAt        DateTime          @default(now())
  AttendanceRecord AttendanceRecord? @relation(fields: [attendanceId], references: [id], onUpdate: NoAction)
  User             User              @relation("PresenceEventEmployee", fields: [employeeId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  actor            User?             @relation("PresenceEventActor", fields: [actorId], references: [id], onDelete: SetNull)
  Organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  AttendanceSite   AttendanceSite?   @relation(fields: [siteId], references: [id], onUpdate: NoAction)

  @@index([attendanceId, recordedAt], map: "AttendancePresenceEvent_attendance_recorded_idx")
  @@index([employeeId, recordedAt], map: "AttendancePresenceEvent_employee_recorded_idx")
  @@index([actorId, recordedAt])
}

model AttendanceSite {
  id                      String                    @id
  organizationId          String
  name                    String
  address                 String?
  latitude                Decimal                   @db.Decimal(10, 7)
  longitude               Decimal                   @db.Decimal(10, 7)
  radiusMeters            Int                       @default(250)
  timezone                String?
  managerId               String?
  geofenceMode            String                    @default("WARNING")
  qrCode                  String?
  active                  Boolean                   @default(true)
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @default(now())
  projectId               String?
  outsideGraceMinutes     Int                       @default(60)
  autoFinalize            Boolean                   @default(true)
  geofenceType            String                    @default("RADIUS")
  boundary                Json?
  areaSqMeters            Float?
  perimeterMeters         Float?
  AttendanceAnomaly       AttendanceAnomaly[]
  AttendancePresenceEvent AttendancePresenceEvent[]
  User                    User?                     @relation(fields: [managerId], references: [id], onUpdate: NoAction)
  Organization            Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  Project                 Project?                  @relation(fields: [projectId], references: [id], onUpdate: NoAction)
  AttendanceSiteEmployee  AttendanceSiteEmployee[]
  siteAdmins              AttendanceSiteAdmin[]

  @@index([organizationId, active])
  @@index([projectId])
}

model AttendanceSiteEmployee {
  siteId         String
  employeeId     String
  isPrimary      Boolean        @default(false)
  createdAt      DateTime       @default(now())
  User           User           @relation(fields: [employeeId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  AttendanceSite AttendanceSite @relation(fields: [siteId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([siteId, employeeId])
  @@index([employeeId])
}

// Site Admin / Project Manager (UserRole SITE_ADMIN) assigned to a site. One
// person can hold many sites and a site can have several. Assigned by
// ADMIN/CEO from Attendance Sites; the role only marks attendance for the
// employees of the sites listed here.
model AttendanceSiteAdmin {
  siteId         String
  userId         String
  organizationId String
  assignedById   String?
  createdAt      DateTime       @default(now())
  site           AttendanceSite @relation(fields: [siteId], references: [id], onDelete: Cascade)
  user           User           @relation("SiteAdminOf", fields: [userId], references: [id], onDelete: Cascade)
  assignedBy     User?          @relation("SiteAdminAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)

  @@id([siteId, userId])
  @@index([userId])
  @@index([organizationId])
}

model AttendanceSyncEvent {
  id             String       @id
  clientEventId  String       @unique
  organizationId String
  employeeId     String
  eventType      String
  recordedAt     DateTime
  localDate      DateTime     @db.Date
  payload        Json
  status         String       @default("PENDING")
  processedAt    DateTime?
  lastError      String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now())
  User           User         @relation(fields: [employeeId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  Organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([employeeId, status])
  @@index([organizationId, createdAt])
}

// Per-role, per-organization CRUD grant for the Attendance module, editable
// by ADMIN/CEO/MANAGER from Settings. Roles with no row here fall back to a
// hardcoded default (see backend/src/utils/permissions.js) — ADMIN/CEO/
// MANAGER never get a row at all, since they're always full-access and
// can't be downgraded through this table.
model AttendancePermission {
  id             String       @id @default(cuid())
  organizationId String
  role           UserRole
  canCreate      Boolean      @default(false)
  canRead        Boolean      @default(false)
  canUpdate      Boolean      @default(false)
  canDelete      Boolean      @default(false)
  updatedAt      DateTime     @updatedAt
  Organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, role])
}

model TimeEntry {
  id             String       @id
  organizationId String
  employeeId     String
  projectId      String?
  taskId         String?
  date           DateTime     @db.Date
  hours          Decimal      @db.Decimal(6, 2)
  note           String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime
  User           User         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  Organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  Project        Project?     @relation(fields: [projectId], references: [id])
  Task           Task?        @relation(fields: [taskId], references: [id])

  @@index([employeeId, date])
  @@index([organizationId, date])
  @@index([projectId, date])
  @@index([taskId, date])
}

