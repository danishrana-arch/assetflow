generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Organization {
  id                     String                   @id @default(cuid())
  name                   String
  slug                   String                   @unique
  logoUrl                String?
  primaryColor           String                   @default("#3E63DD")
  accentColor            String                   @default("#16A34A")
  theme                  String                   @default("light")
  planTier               PlanTier                 @default(FREE)
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  casualLeaveAllowance   Int                      @default(6)
  sickLeaveAllowance     Int                      @default(8)
  lateDeductionAmount    Decimal                  @default(500) @db.Decimal(10, 2)
  payrollAccountNumber   String?
  payrollBankName        String?
  workingHoursPerDay     Decimal                  @default(8) @db.Decimal(4, 2)
  workingDaysPerWeek     Int                      @default(5)
  companyId              String?
  parentOrganizationId   String?
  geofenceEnabled        Boolean                  @default(false)
  officeLatitude         Decimal?                 @db.Decimal(10, 7)
  officeLongitude        Decimal?                 @db.Decimal(10, 7)
  geofenceRadiusMeters   Int                      @default(200)
  archivedAt             DateTime?
  shiftStartDefault      String?
  shiftEndDefault        String?
  lateThresholdMinutes   Int                      @default(15)
  announcements          Announcement[]
  assets                 Asset[]
  auditLogs              AuditLog[]
  biometricDevices       BiometricDevice[]
  biometricPunches       BiometricPunch[]
  companyEvents          CompanyEvent[]
  departments            Department[]
  employeeForms          EmployeeForm[]
  EmployeeFormInvitation EmployeeFormInvitation[]
  formSubmissions        EmployeeFormSubmission[]
  holidays               Holiday[]
  notifications          Notification[]
  company                Organization?            @relation("CompanyOrganizations", fields: [companyId], references: [id])
  organizations          Organization[]           @relation("CompanyOrganizations")
  parentOrganization     Organization?            @relation("OrganizationHierarchy", fields: [parentOrganizationId], references: [id])
  childOrganizations     Organization[]           @relation("OrganizationHierarchy")
  performanceReviews     PerformanceReview[]
  projects               Project[]
  Task                   Task[]
  tickets                Ticket[]
  TimeEntry              TimeEntry[]
  users                  User[]

  @@index([companyId])
  @@index([parentOrganizationId])
  @@index([archivedAt])
}

model Announcement {
  id             String       @id @default(cuid())
  organizationId String
  createdById    String
  title          String
  body           String
  audienceType   String       @default("ALL")
  audienceId     String?
  publishedAt    DateTime     @default(now())
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  createdBy      User         @relation("AnnouncementCreator", fields: [createdById], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, publishedAt])
  @@index([audienceType, audienceId])
}

model CompanyEvent {
  id             String       @id @default(cuid())
  organizationId String
  createdById    String?
  title          String
  date           DateTime     @db.Date
  description    String?
  type           String       @default("ANNUAL_EVENT")
  isAnnual       Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  createdBy      User?        @relation("CompanyEventCreator", fields: [createdById], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, date])
  @@index([organizationId, type])
}

model Holiday {
  id             String       @id @default(cuid())
  organizationId String
  date           DateTime     @db.Date
  name           String
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, date])
  @@index([organizationId])
}

model AuditLog {
  id             String       @id @default(cuid())
  organizationId String
  actorId        String?
  action         String
  targetType     String?
  targetId       String?
  note           String?
  createdAt      DateTime     @default(now())
  actor          User?        @relation(fields: [actorId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, createdAt])
}

model User {
  id                           String                    @id @default(cuid())
  organizationId               String
  name                         String
  email                        String                    @unique
  password                     String
  phone                        String?
  photoUrl                     String?
  role                         UserRole                  @default(EMPLOYEE)
  status                       EmployeeStatus            @default(ACTIVE)
  departmentId                 String?
  managerId                    String?
  cnic                         String?
  dob                          DateTime?
  address                      String?
  skill                        String?
  seniorityLevel               SeniorityLevel?
  canManageAttendance          Boolean                   @default(false)
  createdAt                    DateTime                  @default(now())
  updatedAt                    DateTime                  @updatedAt
  baseSalary                   Decimal?                  @db.Decimal(12, 2)
  bankAccountNumber            String?
  bankName                     String?
  designation                  String?
  joiningDate                  DateTime?
  workLocationType             WorkLocationType          @default(OFFICE)
  personalEmail                String?
  fatherName                   String?
  education                    String?
  currentUniversity            String?
  linkedinUrl                  String?
  shiftStart                   String?
  shiftEnd                     String?
  announcementsCreated         Announcement[]            @relation("AnnouncementCreator")
  assignedAssets               Asset[]                   @relation("AssignedAssets")
  assetRequests                AssetRequest[]            @relation("AssetRequestedBy")
  assetRequestsReviewed        AssetRequest[]            @relation("AssetRequestReviewer")
  attendanceRecords            AttendanceRecord[]        @relation("AttendanceOf")
  attendanceMarkedBy           AttendanceRecord[]        @relation("AttendanceMarkedBy")
  auditLogs                    AuditLog[]
  biometricMappings            BiometricDeviceEmployee[]
  biometricPunches             BiometricPunch[]
  certifications               Certification[]
  companyEvents                CompanyEvent[]            @relation("CompanyEventCreator")
  managedDepartments           Department[]              @relation("DepartmentManager")
  employeeFormsCreated         EmployeeForm[]            @relation("EmployeeFormCreator")
  EmployeeFormInvitation       EmployeeFormInvitation[]
  formSubmissionsConverted     EmployeeFormSubmission[]  @relation("FormSubmissionEmployee")
  leaveApplications            LeaveApplication[]        @relation("LeaveApplicant")
  leaveApplicationsReviewed    LeaveApplication[]        @relation("LeaveReviewer")
  lifecycleEvents              LifecycleEvent[]          @relation("EventActor")
  notificationsCreated         Notification[]            @relation("NotificationCreator")
  notifications                Notification[]            @relation("NotificationRecipient")
  payrollApprovedBy            PayrollRecord[]           @relation("PayrollApprovedBy")
  payrollRecords               PayrollRecord[]           @relation("PayrollOf")
  payrollGeneratedBy           PayrollRecord[]           @relation("PayrollGeneratedBy")
  performanceReviewsReceived   PerformanceReview[]       @relation("PerformanceEmployee")
  performanceReviewsGiven      PerformanceReview[]       @relation("PerformanceReviewer")
  managedProjects              Project[]                 @relation("ProjectManager")
  projectMemberships           ProjectMember[]
  Task_Task_assignedToIdToUser Task[]                    @relation("Task_assignedToIdToUser")
  Task_Task_createdByIdToUser  Task[]                    @relation("Task_createdByIdToUser")
  tickets                      Ticket[]                  @relation("TicketRaisedBy")
  TimeEntry                    TimeEntry[]
  department                   Department?               @relation(fields: [departmentId], references: [id])
  manager                      User?                     @relation("ManagerReports", fields: [managerId], references: [id])
  reports                      User[]                    @relation("ManagerReports")
  organization                 Organization              @relation(fields: [organizationId], references: [id])
}

model Notification {
  id             String       @id @default(cuid())
  organizationId String
  recipientId    String
  createdById    String?
  type           String       @default("INFO")
  title          String
  message        String?
  link           String?
  createdAt      DateTime     @default(now())
  readAt         DateTime?
  createdBy      User?        @relation("NotificationCreator", fields: [createdById], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  recipient      User         @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId, readAt, createdAt])
  @@index([organizationId, createdAt])
}

model Certification {
  id            String    @id @default(cuid())
  employeeId    String
  name          String
  institute     String
  credentialId  String?
  credentialUrl String?
  issuedDate    DateTime?
  expiryDate    DateTime?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  employee      User      @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
}

model EmployeeForm {
  id             String                   @id @default(cuid())
  organizationId String
  createdById    String?
  title          String
  tokenHash      String                   @unique
  tokenEncrypted String?
  active         Boolean                  @default(true)
  expiresAt      DateTime?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  createdBy      User?                    @relation("EmployeeFormCreator", fields: [createdById], references: [id])
  organization   Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  submissions    EmployeeFormSubmission[]

  @@index([organizationId, active])
}

model EmployeeFormSubmission {
  id                     String                       @id @default(cuid())
  invitationId           String                       @unique
  organizationId         String
  data                   Json
  submittedAt            DateTime                     @default(now())
  createdAt              DateTime                     @default(now())
  updatedAt              DateTime
  formId                 String?
  name                   String?
  fatherName             String?
  personalEmail          String?
  phone                  String?
  address                String?
  cnic                   String?
  dob                    DateTime?
  education              String?
  currentUniversity      String?
  seniorityLevel         SeniorityLevel?
  companyEmail           String?
  linkedinUrl            String?
  notes                  String?
  status                 EmployeeFormSubmissionStatus @default(SUBMITTED)
  convertedEmployeeId    String?
  convertedEmployee      User?                        @relation("FormSubmissionEmployee", fields: [convertedEmployeeId], references: [id])
  form                   EmployeeForm?                @relation(fields: [formId], references: [id], onDelete: Cascade)
  EmployeeFormInvitation EmployeeFormInvitation       @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  organization           Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([formId, submittedAt])
  @@index([organizationId, status])
  @@index([organizationId, submittedAt])
}

model LeaveApplication {
  id             String      @id @default(cuid())
  organizationId String
  employeeId     String
  startDate      DateTime    @db.Date
  endDate        DateTime    @db.Date
  reason         String
  type           LeaveType   @default(CASUAL)
  isHalfDay      Boolean     @default(false)
  status         LeaveStatus @default(PENDING)
  reviewedById   String?
  reviewedAt     DateTime?
  reviewNote     String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  employee       User        @relation("LeaveApplicant", fields: [employeeId], references: [id], onDelete: Cascade)
  reviewedBy     User?       @relation("LeaveReviewer", fields: [reviewedById], references: [id])

  @@index([organizationId, status])
  @@index([employeeId])
}

model AssetRequest {
  id               String             @id @default(cuid())
  organizationId   String
  employeeId       String
  category         String
  reason           String
  status           AssetRequestStatus @default(PENDING)
  reviewedById     String?
  reviewedAt       DateTime?
  reviewNote       String?
  fulfilledAssetId String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  employee         User               @relation("AssetRequestedBy", fields: [employeeId], references: [id], onDelete: Cascade)
  fulfilledAsset   Asset?             @relation(fields: [fulfilledAssetId], references: [id])
  reviewedBy       User?              @relation("AssetRequestReviewer", fields: [reviewedById], references: [id])

  @@index([organizationId, status])
  @@index([employeeId])
}

model Department {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  createdAt      DateTime     @default(now())
  managerId      String?
  assets         Asset[]
  manager        User?        @relation("DepartmentManager", fields: [managerId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id])
  employees      User[]

  @@unique([organizationId, name])
  @@index([managerId])
  @@index([organizationId])
}

model Asset {
  id                String           @id @default(cuid())
  organizationId    String
  name              String
  category          String?
  serialNumber      String           @unique
  cpu               String?
  ram               String?
  storage           String?
  purchaseDate      DateTime?
  warrantyEnd       DateTime?
  status            AssetStatus      @default(AVAILABLE)
  departmentId      String?
  assignedToId      String?
  photos            String[]         @default([])
  documents         String[]         @default([])
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  assignedTo        User?            @relation("AssignedAssets", fields: [assignedToId], references: [id])
  department        Department?      @relation(fields: [departmentId], references: [id])
  organization      Organization     @relation(fields: [organizationId], references: [id])
  fulfilledRequests AssetRequest[]
  lifecycleEvents   LifecycleEvent[]
  tickets           Ticket[]
}

model LifecycleEvent {
  id         String             @id @default(cuid())
  assetId    String
  type       LifecycleEventType
  note       String?
  actorId    String?
  occurredAt DateTime           @default(now())
  cost       Decimal?           @db.Decimal(10, 2)
  actor      User?              @relation("EventActor", fields: [actorId], references: [id])
  asset      Asset              @relation(fields: [assetId], references: [id])
}

model Project {
  id                        String          @id @default(cuid())
  organizationId            String
  name                      String
  description               String?
  clientName                String?
  projectUrl                String?
  status                    ProjectStatus   @default(NOT_STARTED)
  startDate                 DateTime?       @db.Date
  deadline                  DateTime?       @db.Date
  completedAt               DateTime?
  totalHours                Decimal         @default(0) @db.Decimal(10, 2)
  managerId                 String?
  createdAt                 DateTime        @default(now())
  updatedAt                 DateTime        @updatedAt
  technologies              String[]        @default([])
  deadlineReminderSentAt    DateTime?
  deadlineOverdueNotifiedAt DateTime?
  manager                   User?           @relation("ProjectManager", fields: [managerId], references: [id])
  organization              Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members                   ProjectMember[]
  Task                      Task[]
  TimeEntry                 TimeEntry[]

  @@index([organizationId, status])
  @@index([organizationId, deadline])
}

model ProjectMember {
  id         String   @id @default(cuid())
  projectId  String
  employeeId String
  hoursSpent Decimal  @default(0) @db.Decimal(10, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  employee   User     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, employeeId])
  @@index([employeeId])
}

model PerformanceReview {
  id             String       @id @default(cuid())
  organizationId String
  employeeId     String
  reviewerId     String?
  periodStart    DateTime     @db.Date
  periodEnd      DateTime     @db.Date
  rating         Int
  goals          String?
  achievements   String?
  feedback       String?
  status         String       @default("DRAFT")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  employee       User         @relation("PerformanceEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reviewer       User?        @relation("PerformanceReviewer", fields: [reviewerId], references: [id])

  @@index([organizationId, employeeId, periodEnd])
  @@index([reviewerId, createdAt])
}

model Ticket {
  id             String         @id @default(cuid())
  organizationId String
  subject        String
  description    String
  priority       TicketPriority @default(MEDIUM)
  status         TicketStatus   @default(OPEN)
  imageUrl       String?
  raisedById     String?
  assetId        String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  category       String?
  asset          Asset?         @relation(fields: [assetId], references: [id])
  organization   Organization   @relation(fields: [organizationId], references: [id])
  raisedBy       User?          @relation("TicketRaisedBy", fields: [raisedById], references: [id])
}

model BiometricDevice {
  id                      String                    @id @default(cuid())
  organizationId          String
  name                    String
  vendor                  BiometricVendor
  model                   String?
  serialNumber            String?
  ipAddress               String?
  port                    Int?
  connectionMode          BiometricConnectionMode   @default(PULL)
  enabled                 Boolean                   @default(true)
  doorEnabled             Boolean                   @default(false)
  unlockSeconds           Int                       @default(5)
  relayUrl                String?
  relaySecret             String?
  communicationKey        String?
  connectorTokenHash      String?
  connectorTokenCreatedAt DateTime?
  lastSeenAt              DateTime?
  lastSyncAt              DateTime?
  lastError               String?
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  organization            Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  mappings                BiometricDeviceEmployee[]
  punches                 BiometricPunch[]

  @@unique([organizationId, serialNumber])
  @@index([organizationId])
}

model BiometricDeviceEmployee {
  id             String          @id @default(cuid())
  deviceId       String
  employeeId     String
  externalUserId String
  createdAt      DateTime        @default(now())
  device         BiometricDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  employee       User            @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([deviceId, externalUserId])
  @@unique([deviceId, employeeId])
  @@index([employeeId])
}

model BiometricPunch {
  id             String          @id @default(cuid())
  organizationId String
  deviceId       String
  employeeId     String?
  externalUserId String
  occurredAt     DateTime
  verification   String?
  externalId     String?
  rawPayload     Json?
  createdAt      DateTime        @default(now())
  device         BiometricDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  employee       User?           @relation(fields: [employeeId], references: [id])
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([deviceId, externalId])
  @@index([organizationId, occurredAt])
  @@index([deviceId, occurredAt])
}

model AttendanceRecord {
  id                String           @id @default(cuid())
  organizationId    String
  employeeId        String
  date              DateTime         @db.Date
  status            AttendanceStatus @default(PRESENT)
  markedById        String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  source            AttendanceSource @default(MANUAL)
  biometricDeviceId String?
  checkInAt         DateTime?
  checkOutAt        DateTime?
  workingMinutes    Int?
  latitude          Decimal?         @db.Decimal(10, 7)
  longitude         Decimal?         @db.Decimal(10, 7)
  distanceMeters    Int?
  autoFlagged       Boolean          @default(false)
  employee          User             @relation("AttendanceOf", fields: [employeeId], references: [id], onDelete: Cascade)
  markedBy          User?            @relation("AttendanceMarkedBy", fields: [markedById], references: [id])

  @@unique([employeeId, date])
  @@index([organizationId, date])
  @@index([biometricDeviceId])
}

model PayrollRecord {
  id                String        @id @default(cuid())
  organizationId    String
  employeeId        String
  month             Int
  year              Int
  baseSalary        Decimal       @db.Decimal(12, 2)
  bonus             Decimal       @default(0) @db.Decimal(12, 2)
  deductions        Decimal       @default(0) @db.Decimal(12, 2)
  unpaidLeaveDays   Int           @default(0)
  netPay            Decimal       @db.Decimal(12, 2)
  status            PayrollStatus @default(DRAFT)
  note              String?
  generatedById     String?
  paidAt            DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  approvedAt        DateTime?
  approvedById      String?
  bankAccountNumber String?
  bankName          String?
  halfDayLeaveDays  Int           @default(0)
  lateDays          Int           @default(0)
  approvedBy        User?         @relation("PayrollApprovedBy", fields: [approvedById], references: [id])
  employee          User          @relation("PayrollOf", fields: [employeeId], references: [id], onDelete: Cascade)
  generatedBy       User?         @relation("PayrollGeneratedBy", fields: [generatedById], references: [id])

  @@unique([employeeId, month, year])
  @@index([organizationId, year, month])
}

model EmployeeFormInvitation {
  id                     String                  @id
  organizationId         String
  createdById            String
  recipientName          String?
  recipientEmail         String?
  title                  String
  description            String?
  fields                 Json
  tokenHash              String                  @unique
  tokenEncrypted         String?
  expiresAt              DateTime?
  status                 String                  @default("SENT")
  submittedAt            DateTime?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime
  User                   User                    @relation(fields: [createdById], references: [id])
  Organization           Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  EmployeeFormSubmission EmployeeFormSubmission?

  @@index([organizationId, createdAt])
  @@index([organizationId, status])
}

model Task {
  id                           String       @id
  organizationId               String
  projectId                    String
  title                        String
  description                  String?
  status                       String       @default("TODO")
  priority                     String       @default("MEDIUM")
  assignedToId                 String?
  createdById                  String?
  dueDate                      DateTime?    @db.Date
  estimatedHours               Decimal      @default(0) @db.Decimal(10, 2)
  actualHours                  Decimal      @default(0) @db.Decimal(10, 2)
  createdAt                    DateTime     @default(now())
  updatedAt                    DateTime
  User_Task_assignedToIdToUser User?        @relation("Task_assignedToIdToUser", fields: [assignedToId], references: [id])
  User_Task_createdByIdToUser  User?        @relation("Task_createdByIdToUser", fields: [createdById], references: [id])
  Organization                 Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  Project                      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  TimeEntry                    TimeEntry[]

  @@index([assignedToId, status])
  @@index([dueDate])
  @@index([organizationId, projectId])
  @@index([organizationId, status])
}

model TimeEntry {
  id             String       @id
  organizationId String
  employeeId     String
  projectId      String?
  taskId         String?
  date           DateTime     @db.Date
  hours          Decimal      @db.Decimal(6, 2)
  note           String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime
  User           User         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  Organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  Project        Project?     @relation(fields: [projectId], references: [id])
  Task           Task?        @relation(fields: [taskId], references: [id])

  @@index([employeeId, date])
  @@index([organizationId, date])
  @@index([projectId, date])
  @@index([taskId, date])
}

model playing_with_neon {
  id    Int    @id @default(autoincrement())
  name  String
  value Float? @db.Real
}

enum PlanTier {
  FREE
  PRO
  BUSINESS
  ENTERPRISE
}

enum UserRole {
  ADMIN
  MANAGER
  EMPLOYEE
  CEO
  SALES_HEAD
  HR
  MANAGEMENT
  DEPARTMENT_HEAD
  IT_MANAGER
}

enum EmployeeFormSubmissionStatus {
  SUBMITTED
  REVIEWED
  CONVERTED
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum LeaveType {
  SICK
  CASUAL
  UNPAID
}

enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  LEFT_COMPANY
}

enum AssetStatus {
  ASSIGNED
  AVAILABLE
  REPAIR
  LOST
  DISPOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum LifecycleEventType {
  PURCHASED
  ASSIGNED
  UNASSIGNED
  REPAIR_STARTED
  REPAIR_COMPLETED
  UPGRADED
  WARRANTY_EXPIRED
  RETURNED
  DISPOSED
  NOTE
}

enum SeniorityLevel {
  INTERN
  JUNIOR
  SENIOR
  LEAD
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LEAVE
  LATE
}

enum AttendanceSource {
  MANUAL
  BIOMETRIC
}

enum BiometricVendor {
  ZKTECO
  HIKVISION
  SUPREMA
  ANVIZ
  ESSL
  HTTP
  CUSTOM
}

enum BiometricConnectionMode {
  PULL
  PUSH
  HTTP
}

enum ProjectStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum PayrollStatus {
  DRAFT
  PAID
  PENDING_APPROVAL
}

enum AssetRequestStatus {
  PENDING
  APPROVED
  REJECTED
  FULFILLED
}

enum WorkLocationType {
  OFFICE
  FIELD
}
