generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Organization {
  id                   String    @id @default(cuid())
  name                 String
  slug                 String    @unique
  logoUrl              String?
  primaryColor         String    @default("#3E63DD")
  accentColor          String    @default("#16A34A")
  theme                String    @default("light")
  planTier             PlanTier  @default(FREE)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  archivedAt           DateTime?
  casualLeaveAllowance Int       @default(6)
  sickLeaveAllowance   Int       @default(8)
  lateDeductionAmount  Decimal   @default(500) @db.Decimal(10, 2)
  payrollAccountNumber String?
  payrollBankName      String?
  workingHoursPerDay   Decimal   @default(8) @db.Decimal(4, 2)
  workingDaysPerWeek   Int       @default(5)

  // Attendance geofencing — office coordinates + allowed radius. When
  // enabled, an OFFICE-type employee marking themselves Present outside
  // this radius is auto-flagged and recorded as Absent until an admin
  // reviews and overrides it (FIELD-type employees are exempt).
  geofenceEnabled      Boolean  @default(false)
  officeLatitude       Decimal? @db.Decimal(10, 7)
  officeLongitude      Decimal? @db.Decimal(10, 7)
  geofenceRadiusMeters Int      @default(200)

  // Company hierarchy
  // Main company: companyId = its own id, parentOrganizationId = null
  // Subcompany: companyId = main company's id, parentOrganizationId = parent organization's id
  companyId            String?
  parentOrganizationId String?

  // Company hierarchy relations
  company            Organization?  @relation("CompanyOrganizations", fields: [companyId], references: [id])
  organizations      Organization[] @relation("CompanyOrganizations")
  parentOrganization Organization?  @relation("OrganizationHierarchy", fields: [parentOrganizationId], references: [id])
  childOrganizations Organization[] @relation("OrganizationHierarchy")

  assets           Asset[]
  auditLogs        AuditLog[]
  biometricDevices BiometricDevice[]
  biometricPunches BiometricPunch[]
  departments      Department[]
  holidays         Holiday[]
  projects         Project[]
  announcements    Announcement[]
  tickets          Ticket[]
  users            User[]

  @@index([companyId])
  @@index([parentOrganizationId])
  @@index([archivedAt])
}

model Announcement {
  id             String       @id @default(cuid())
  organizationId String
  createdById    String
  title          String
  body           String
  audienceType   String       @default("ALL")
  audienceId     String?
  publishedAt    DateTime     @default(now())
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy      User         @relation("AnnouncementCreator", fields: [createdById], references: [id])

  @@index([organizationId, publishedAt])
  @@index([audienceType, audienceId])
}

model Holiday {
  id             String       @id @default(cuid())
  organizationId String
  date           DateTime     @db.Date
  name           String
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, date])
  @@index([organizationId])
}

model AuditLog {
  id             String       @id @default(cuid())
  organizationId String
  actorId        String?
  action         String
  targetType     String?
  targetId       String?
  note           String?
  createdAt      DateTime     @default(now())
  actor          User?        @relation(fields: [actorId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, createdAt])
}

model User {
  id                        String                    @id @default(cuid())
  organizationId            String
  name                      String
  email                     String                    @unique
  password                  String
  phone                     String?
  photoUrl                  String?
  role                      UserRole                  @default(EMPLOYEE)
  status                    EmployeeStatus            @default(ACTIVE)
  departmentId              String?
  managerId                 String?
  cnic                      String?
  dob                       DateTime?
  address                   String?
  skill                     String?
  seniorityLevel            SeniorityLevel?
  canManageAttendance       Boolean                   @default(false)
  createdAt                 DateTime                  @default(now())
  updatedAt                 DateTime                  @updatedAt
  baseSalary                Decimal?                  @db.Decimal(12, 2)
  bankAccountNumber         String?
  bankName                  String?
  designation               String?
  joiningDate               DateTime?
  workLocationType          WorkLocationType          @default(OFFICE)
  assignedAssets            Asset[]                   @relation("AssignedAssets")
  assetRequests             AssetRequest[]            @relation("AssetRequestedBy")
  assetRequestsReviewed     AssetRequest[]            @relation("AssetRequestReviewer")
  attendanceRecords         AttendanceRecord[]        @relation("AttendanceOf")
  attendanceMarkedBy        AttendanceRecord[]        @relation("AttendanceMarkedBy")
  auditLogs                 AuditLog[]
  biometricMappings         BiometricDeviceEmployee[]
  biometricPunches          BiometricPunch[]
  leaveApplications         LeaveApplication[]        @relation("LeaveApplicant")
  leaveApplicationsReviewed LeaveApplication[]        @relation("LeaveReviewer")
  lifecycleEvents           LifecycleEvent[]          @relation("EventActor")
  payrollApprovedBy         PayrollRecord[]           @relation("PayrollApprovedBy")
  payrollRecords            PayrollRecord[]           @relation("PayrollOf")
  payrollGeneratedBy        PayrollRecord[]           @relation("PayrollGeneratedBy")
  managedProjects           Project[]                 @relation("ProjectManager")
  announcementsCreated      Announcement[]            @relation("AnnouncementCreator")
  projectMemberships        ProjectMember[]
  tickets                   Ticket[]                  @relation("TicketRaisedBy")
  department                Department?               @relation(fields: [departmentId], references: [id])
  manager                   User?                     @relation("ManagerReports", fields: [managerId], references: [id])
  reports                   User[]                    @relation("ManagerReports")
  organization              Organization              @relation(fields: [organizationId], references: [id])
}

model LeaveApplication {
  id             String      @id @default(cuid())
  organizationId String
  employeeId     String
  startDate      DateTime    @db.Date
  endDate        DateTime    @db.Date
  reason         String
  type           LeaveType   @default(CASUAL)
  isHalfDay      Boolean     @default(false)
  status         LeaveStatus @default(PENDING)
  reviewedById   String?
  reviewedAt     DateTime?
  reviewNote     String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  employee       User        @relation("LeaveApplicant", fields: [employeeId], references: [id], onDelete: Cascade)
  reviewedBy     User?       @relation("LeaveReviewer", fields: [reviewedById], references: [id])

  @@index([organizationId, status])
  @@index([employeeId])
}

model AssetRequest {
  id               String             @id @default(cuid())
  organizationId   String
  employeeId       String
  category         String
  reason           String
  status           AssetRequestStatus @default(PENDING)
  reviewedById     String?
  reviewedAt       DateTime?
  reviewNote       String?
  fulfilledAssetId String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  employee         User               @relation("AssetRequestedBy", fields: [employeeId], references: [id], onDelete: Cascade)
  fulfilledAsset   Asset?             @relation(fields: [fulfilledAssetId], references: [id])
  reviewedBy       User?              @relation("AssetRequestReviewer", fields: [reviewedById], references: [id])

  @@index([organizationId, status])
  @@index([employeeId])
}

model Department {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  createdAt      DateTime     @default(now())
  assets         Asset[]
  organization   Organization @relation(fields: [organizationId], references: [id])
  employees      User[]

  @@unique([organizationId, name])
}

model Asset {
  id                String           @id @default(cuid())
  organizationId    String
  name              String
  category          String?
  serialNumber      String           @unique
  cpu               String?
  ram               String?
  storage           String?
  purchaseDate      DateTime?
  warrantyEnd       DateTime?
  status            AssetStatus      @default(AVAILABLE)
  departmentId      String?
  assignedToId      String?
  photos            String[]         @default([])
  documents         String[]         @default([])
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  assignedTo        User?            @relation("AssignedAssets", fields: [assignedToId], references: [id])
  department        Department?      @relation(fields: [departmentId], references: [id])
  organization      Organization     @relation(fields: [organizationId], references: [id])
  fulfilledRequests AssetRequest[]
  lifecycleEvents   LifecycleEvent[]
  tickets           Ticket[]
}

model LifecycleEvent {
  id         String             @id @default(cuid())
  assetId    String
  type       LifecycleEventType
  note       String?
  actorId    String?
  occurredAt DateTime           @default(now())
  cost       Decimal?           @db.Decimal(10, 2)
  actor      User?              @relation("EventActor", fields: [actorId], references: [id])
  asset      Asset              @relation(fields: [assetId], references: [id])
}

model Project {
  id                        String          @id @default(cuid())
  organizationId            String
  name                      String
  description               String?
  clientName                String?
  projectUrl                String?
  status                    ProjectStatus   @default(NOT_STARTED)
  startDate                 DateTime?       @db.Date
  deadline                  DateTime?       @db.Date
  completedAt               DateTime?
  totalHours                Decimal         @default(0) @db.Decimal(10, 2)
  managerId                 String?
  createdAt                 DateTime        @default(now())
  updatedAt                 DateTime        @updatedAt
  technologies              String[]        @default([])
  deadlineReminderSentAt    DateTime?
  deadlineOverdueNotifiedAt DateTime?
  manager                   User?           @relation("ProjectManager", fields: [managerId], references: [id])
  organization              Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members                   ProjectMember[]

  @@index([organizationId, status])
  @@index([organizationId, deadline])
}

model ProjectMember {
  id         String   @id @default(cuid())
  projectId  String
  employeeId String
  hoursSpent Decimal  @default(0) @db.Decimal(10, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  employee   User     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, employeeId])
  @@index([employeeId])
}

model Ticket {
  id             String         @id @default(cuid())
  organizationId String
  subject        String
  description    String
  priority       TicketPriority @default(MEDIUM)
  status         TicketStatus   @default(OPEN)
  imageUrl       String?
  raisedById     String?
  assetId        String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  category       String?
  asset          Asset?         @relation(fields: [assetId], references: [id])
  organization   Organization   @relation(fields: [organizationId], references: [id])
  raisedBy       User?          @relation("TicketRaisedBy", fields: [raisedById], references: [id])
}

model BiometricDevice {
  id                      String                    @id @default(cuid())
  organizationId          String
  name                    String
  vendor                  BiometricVendor
  model                   String?
  serialNumber            String?
  ipAddress               String?
  port                    Int?
  connectionMode          BiometricConnectionMode   @default(PULL)
  enabled                 Boolean                   @default(true)
  doorEnabled             Boolean                   @default(false)
  unlockSeconds           Int                       @default(5)
  relayUrl                String?
  relaySecret             String?
  communicationKey        String?
  connectorTokenHash      String?
  connectorTokenCreatedAt DateTime?
  lastSeenAt              DateTime?
  lastSyncAt              DateTime?
  lastError               String?
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  organization            Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  mappings                BiometricDeviceEmployee[]
  punches                 BiometricPunch[]

  @@unique([organizationId, serialNumber])
  @@index([organizationId])
}

model BiometricDeviceEmployee {
  id             String          @id @default(cuid())
  deviceId       String
  employeeId     String
  externalUserId String
  createdAt      DateTime        @default(now())
  device         BiometricDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  employee       User            @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([deviceId, externalUserId])
  @@unique([deviceId, employeeId])
  @@index([employeeId])
}

model BiometricPunch {
  id             String          @id @default(cuid())
  organizationId String
  deviceId       String
  employeeId     String?
  externalUserId String
  occurredAt     DateTime
  verification   String?
  externalId     String?
  rawPayload     Json?
  createdAt      DateTime        @default(now())
  device         BiometricDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  employee       User?           @relation(fields: [employeeId], references: [id])
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([deviceId, externalId])
  @@index([organizationId, occurredAt])
  @@index([deviceId, occurredAt])
}

model AttendanceRecord {
  id                String           @id @default(cuid())
  organizationId    String
  employeeId        String
  date              DateTime         @db.Date
  status            AttendanceStatus @default(PRESENT)
  markedById        String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  source            AttendanceSource @default(MANUAL)
  biometricDeviceId String?
  checkInAt         DateTime?
  checkOutAt        DateTime?
  workingMinutes    Int?
  latitude          Decimal?         @db.Decimal(10, 7)
  longitude         Decimal?         @db.Decimal(10, 7)
  distanceMeters    Int?
  autoFlagged       Boolean          @default(false)
  employee          User             @relation("AttendanceOf", fields: [employeeId], references: [id], onDelete: Cascade)
  markedBy          User?            @relation("AttendanceMarkedBy", fields: [markedById], references: [id])

  @@unique([employeeId, date])
  @@index([organizationId, date])
  @@index([biometricDeviceId])
}

model PayrollRecord {
  id                String        @id @default(cuid())
  organizationId    String
  employeeId        String
  month             Int
  year              Int
  baseSalary        Decimal       @db.Decimal(12, 2)
  bonus             Decimal       @default(0) @db.Decimal(12, 2)
  deductions        Decimal       @default(0) @db.Decimal(12, 2)
  unpaidLeaveDays   Int           @default(0)
  netPay            Decimal       @db.Decimal(12, 2)
  status            PayrollStatus @default(DRAFT)
  note              String?
  generatedById     String?
  paidAt            DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  approvedAt        DateTime?
  approvedById      String?
  bankAccountNumber String?
  bankName          String?
  halfDayLeaveDays  Int           @default(0)
  lateDays          Int           @default(0)
  approvedBy        User?         @relation("PayrollApprovedBy", fields: [approvedById], references: [id])
  employee          User          @relation("PayrollOf", fields: [employeeId], references: [id], onDelete: Cascade)
  generatedBy       User?         @relation("PayrollGeneratedBy", fields: [generatedById], references: [id])

  @@unique([employeeId, month, year])
  @@index([organizationId, year, month])
}

enum PlanTier {
  FREE
  PRO
  BUSINESS
  ENTERPRISE
}

enum UserRole {
  ADMIN
  MANAGER
  EMPLOYEE
  CEO
  SALES_HEAD
  HR
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum LeaveType {
  SICK
  CASUAL
  UNPAID
}

enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  LEFT_COMPANY
}

enum AssetStatus {
  ASSIGNED
  AVAILABLE
  REPAIR
  LOST
  DISPOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum LifecycleEventType {
  PURCHASED
  ASSIGNED
  UNASSIGNED
  REPAIR_STARTED
  REPAIR_COMPLETED
  UPGRADED
  WARRANTY_EXPIRED
  RETURNED
  DISPOSED
  NOTE
}

enum SeniorityLevel {
  INTERN
  JUNIOR
  SENIOR
  LEAD
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LEAVE
  LATE
}

enum AttendanceSource {
  MANUAL
  BIOMETRIC
}

enum BiometricVendor {
  ZKTECO
  HIKVISION
  SUPREMA
  ANVIZ
  ESSL
  HTTP
  CUSTOM
}

enum BiometricConnectionMode {
  PULL
  PUSH
  HTTP
}

enum ProjectStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum PayrollStatus {
  DRAFT
  PAID
  PENDING_APPROVAL
}

enum AssetRequestStatus {
  PENDING
  APPROVED
  REJECTED
  FULFILLED
}

enum WorkLocationType {
  OFFICE
  FIELD
}
