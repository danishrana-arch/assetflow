# Attendance site maps now use Leaflet + OpenStreetMap tiles (no API key
# needed). VITE_GOOGLE_MAPS_API_KEY was removed along with the Google Maps
# based site map component.

# Base URL of the deployed backend API, including the /api suffix.
# Falls back to http://localhost:4000/api when unset, which only works for
# local dev — a production deploy MUST set this to the real backend URL
# (see frontend/src/api/client.js).
VITE_API_URL=http://localhost:4000/api

# General-purpose environment flag other frontend code can branch on later
# (e.g. hide debug logging, disable dev-only tooling). Not read automatically
# by anything today — Vite already exposes import.meta.env.PROD/DEV/MODE for
# basic dev-vs-build checks, but those don't distinguish a real Vercel
# Production deploy from a Preview deploy (both build in "production" mode).
# This flag exists for that distinction; set it explicitly per Vercel
# environment. Only vars prefixed VITE_ are exposed to browser code, which is
# why this can't just be Vercel's own VERCEL_ENV.
VITE_APP_ENV=development
