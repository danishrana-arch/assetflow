ASSETFLOW_API_URL=https://api.example.com/api/biometric
CONNECTOR_TOKEN=afc_xxx
POLL_INTERVAL_MS=30000
DOOR_RELAY_URL=
DOOR_RELAY_SECRET=
LOCAL_PUSH_PORT=8787

# Max punches sent per request during a sync cycle. A device with no
# watermark yet (first sync, or after a long offline gap) can return
# thousands of punches at once; this batches the push so no single request
# risks a backend timeout, and the watermark is saved after each batch.
PUNCH_BATCH_SIZE=300
